{
	"version": 3,
	"routes": [
		{
			"src": "^/(.*)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"src": "^/bored-at-school$",
			"headers": {
				"Location": "/bored-games/bored-at-school"
			},
			"status": 301
		},
		{
			"src": "^/bored-at-work$",
			"headers": {
				"Location": "/bored-games/bored-at-work"
			},
			"status": 301
		},
		{
			"src": "^/es/bored-at-school$",
			"headers": {
				"Location": "/es/bored-games/bored-at-school"
			},
			"status": 301
		},
		{
			"src": "^/es/bored-at-work$",
			"headers": {
				"Location": "/es/bored-games/bored-at-work"
			},
			"status": 301
		},
		{
			"src": "^/es/waiting-in-line$",
			"headers": {
				"Location": "/es/bored-games/waiting-in-line"
			},
			"status": 301
		},
		{
			"src": "^/games-to-play-when-bored$",
			"headers": {
				"Location": "/bored-games"
			},
			"status": 301
		},
		{
			"src": "^/waiting-in-line$",
			"headers": {
				"Location": "/bored-games/waiting-in-line"
			},
			"status": 301
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/_image$",
			"dest": "_render"
		},
		{
			"src": "^/es/game/([^/]+?)-([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/game/([^/]+?)-([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/zh/game/([^/]+?)-([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "/404.html",
			"status": 404
		}
	]
}