---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { getGame, getRelated } from '~/data/fable-games';
import GameCard, { GRADIENTS, TOOL_STYLES } from './GameCard.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const game = getGame(slug);
if (!game) {
  throw new Error(`Unknown fable game slug: ${slug}`);
}
const related = getRelated(game, 3);
const detailUrl = `/fable-5-2-games/${game.slug}`;
const gradient = GRADIENTS[game.gradient] ?? GRADIENTS.violet;
const toolStyle = TOOL_STYLES[game.toolKey] ?? TOOL_STYLES.claude;

const metadata = {
  title: `${game.name} – Play Free Online | AI-Built Browser Game`,
  description: game.description,
  // No locale versions of this page exist; skip hreflang so we don't point at 404s.
  skipHreflang: true,
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      name: game.name,
      url: `https://minigameshub.org${detailUrl}`,
      description: game.description,
      genre: game.genre,
      playMode: 'SinglePlayer',
      applicationCategory: 'Game',
      operatingSystem: 'Web browser',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...(game.author ? { author: { '@type': 'Person', name: game.author } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://minigameshub.org/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Fable 5.2 Games',
          item: 'https://minigameshub.org/fable-5-2-games',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: game.name,
          item: `https://minigameshub.org${detailUrl}`,
        },
      ],
    },
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-10 sm:px-6 mx-auto lg:px-8 max-w-7xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a
            href="/"
            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white"
          >
            <Icon name="tabler:home" class="w-4 h-4 mr-1.5" aria-hidden="true" />
            Home
          </a>
        </li>
        <li class="flex items-center">
          <Icon name="tabler:chevron-right" class="w-3.5 h-3.5 text-gray-400 mx-1" aria-hidden="true" />
          <a
            href="/fable-5-2-games"
            class="text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white"
          >
            Fable 5.2 Games
          </a>
        </li>
        <li aria-current="page" class="flex items-center">
          <Icon name="tabler:chevron-right" class="w-3.5 h-3.5 text-gray-400 mx-1" aria-hidden="true" />
          <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{game.name}</span>
        </li>
      </ol>
    </nav>

    {/* Hero */}
    <div class={`relative overflow-hidden rounded-3xl bg-gradient-to-br ${gradient} px-6 py-10 sm:px-10 text-white`}>
      <Icon
        name={`tabler:${game.icon}`}
        class="absolute -right-8 -bottom-10 w-56 h-56 text-white/10"
        aria-hidden="true"
      />
      <div class="relative">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold px-2.5 py-1 bg-white/20 rounded-full backdrop-blur-sm">{game.genre}</span>
          <span class="text-xs font-semibold px-2.5 py-1 bg-white/20 rounded-full backdrop-blur-sm">
            Built with {game.tool}
          </span>
          {
            game.chineseUI && (
              <span class="text-xs font-semibold px-2.5 py-1 bg-white/20 rounded-full backdrop-blur-sm">
                Chinese UI
              </span>
            )
          }
        </div>
        <h1 class="font-bold font-heading text-3xl sm:text-4xl md:text-5xl leading-tighter tracking-tighter">
          {game.name}
        </h1>
        {
          game.author && (
            <p class="mt-3 text-white/85">
              by {game.author}
              {game.handle && ` (${game.handle})`}
            </p>
          )
        }
        <p class="mt-3 text-white/90 text-lg max-w-3xl">{game.description}</p>
      </div>
    </div>

    {/* Player */}
    {
      game.embeddable ? (
        <div class="mt-8">
          <div
            class="relative aspect-video bg-slate-900 rounded-2xl overflow-hidden ring-1 ring-gray-200 dark:ring-slate-700 shadow-lg"
            data-fable-player
            data-url={game.url}
            data-title={game.name}
          >
            <div
              class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center"
              data-fable-cover
            >
              <span class="flex items-center justify-center w-20 h-20 rounded-full bg-white/10 ring-1 ring-white/25">
                <Icon name="tabler:player-play" class="w-10 h-10 text-white" aria-hidden="true" />
              </span>
              <p class="text-white font-bold text-xl">{game.name}</p>
              <p class="text-slate-300 text-sm max-w-md">
                {game.genre} · Built with {game.tool}
              </p>
              <button
                type="button"
                data-fable-play
                class="px-8 py-3 bg-primary text-white rounded-full font-semibold text-base hover:opacity-90 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
              >
                Play now
              </button>
              <p class="text-slate-400 text-xs">Loads from the creator&apos;s site when you press Play</p>
            </div>
            <button
              type="button"
              data-fable-fullscreen
              class="hidden absolute top-3 right-3 z-10 inline-flex items-center gap-1.5 px-3 py-1.5 bg-black/60 text-white text-xs font-semibold rounded-full hover:bg-black/80 transition"
            >
              <Icon name="tabler:arrows-maximize" class="w-3.5 h-3.5" aria-hidden="true" />
              Fullscreen
            </button>
          </div>
          <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-3">
            Hosted by the game&apos;s creator — it streams from their site, not ours.
          </p>
        </div>
      ) : (
        <div class="mt-8 rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 p-6 sm:p-8 text-center">
          <Icon name="tabler:external-link" class="w-10 h-10 mx-auto text-amber-600 dark:text-amber-400" aria-hidden="true" />
          <h2 class="font-bold text-xl mt-3">Play on the original site</h2>
          <p class="text-gray-700 dark:text-gray-300 mt-2 max-w-2xl mx-auto">{game.externalReason}</p>
          <a
            href={game.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 mt-5 px-8 py-3 bg-primary text-white rounded-full font-semibold hover:opacity-90 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >
            Play {game.name}
            <Icon name="tabler:external-link" class="w-4 h-4" aria-hidden="true" />
          </a>
        </div>
      )
    }

    {/* Facts + How to Play + About */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-10">
      <div class="lg:col-span-2 space-y-10">
        <div>
          <h2 class="text-2xl font-bold mb-3">How to Play</h2>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{game.howToPlay}</p>
        </div>
        <div>
          <h2 class="text-2xl font-bold mb-3">About {game.name}</h2>
          <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
            {game.about.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
        {game.howItWasMade && (
          <div>
            <h2 class="text-2xl font-bold mb-3">How It Was Made</h2>
            <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
              {game.howItWasMade.text.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            {game.howItWasMade.prompt && (
              <figure class="mt-5">
                <blockquote class="border-l-4 border-primary bg-gray-50 dark:bg-slate-800/60 rounded-r-xl px-5 py-4 text-gray-800 dark:text-gray-200 italic leading-relaxed">
                  “{game.howItWasMade.prompt}”
                </blockquote>
                <figcaption class="text-sm text-gray-500 dark:text-gray-400 mt-2">
                  The original prompt, in the creator’s own words.
                </figcaption>
              </figure>
            )}
          </div>
        )}
      </div>
      <aside class="lg:col-span-1">
        <div class="rounded-2xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/60 p-6 lg:sticky lg:top-24">
          <h2 class="font-bold text-lg mb-4">Game details</h2>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-gray-500 dark:text-gray-400">Genre</dt>
              <dd class="font-medium text-right">{game.genre}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-gray-500 dark:text-gray-400">Built with</dt>
              <dd class="text-right">
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${toolStyle}`}>{game.tool}</span>
              </dd>
            </div>
            {
              game.author && (
                <div class="flex justify-between gap-4">
                  <dt class="text-gray-500 dark:text-gray-400">Creator</dt>
                  <dd class="font-medium text-right">{game.author}</dd>
                </div>
              )
            }
            <div class="flex justify-between gap-4">
              <dt class="text-gray-500 dark:text-gray-400">Price</dt>
              <dd class="font-medium text-right">Free</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-gray-500 dark:text-gray-400">Platform</dt>
              <dd class="font-medium text-right">Browser, no download</dd>
            </div>
            {
              game.license && (
                <div class="flex justify-between gap-4">
                  <dt class="text-gray-500 dark:text-gray-400">License</dt>
                  <dd class="font-medium text-right">{game.license}</dd>
                </div>
              )
            }
            {
              game.chineseUI && (
                <div class="flex justify-between gap-4">
                  <dt class="text-gray-500 dark:text-gray-400">Language</dt>
                  <dd class="font-medium text-right">Chinese UI</dd>
                </div>
              )
            }
          </dl>
          {
            game.github && (
              <a
                href={`https://github.com/${game.github}`}
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
              >
                <Icon name="tabler:brand-github" class="w-4 h-4" aria-hidden="true" />
                View source on GitHub
              </a>
            )
          }
          <a
            href="/fable-5-2-games"
            class="mt-5 flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
          >
            <Icon name="tabler:arrow-left" class="w-4 h-4" aria-hidden="true" />
            Back to all AI-built games
          </a>
        </div>
      </aside>
    </div>

    {/* Related games */}
    <div class="mt-16 pt-10 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-2xl font-bold mb-6">Related games</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {related.map((relatedGame) => (
          <GameCard game={relatedGame} />
        ))}
      </div>
    </div>
  </section>

  {
    game.embeddable && (
      <script is:inline>
        // Click-to-load player: the iframe is only created when Play is pressed,
        // so heavy 3D scenes never load until the player asks for them.
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('[data-fable-player]').forEach(function (box) {
            var playBtn = box.querySelector('[data-fable-play]');
            var fsBtn = box.querySelector('[data-fable-fullscreen]');
            playBtn.addEventListener('click', function () {
              var iframe = document.createElement('iframe');
              iframe.src = box.getAttribute('data-url');
              iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-pointer-lock');
              iframe.setAttribute('allowfullscreen', '');
              iframe.setAttribute('allow', 'fullscreen');
              iframe.className = 'absolute inset-0 w-full h-full border-0';
              iframe.title = box.getAttribute('data-title') + ' — play online';
              box.querySelector('[data-fable-cover]').remove();
              box.appendChild(iframe);
              if (fsBtn) fsBtn.classList.remove('hidden');
            });
            if (fsBtn) {
              fsBtn.addEventListener('click', function () {
                if (box.requestFullscreen) box.requestFullscreen();
              });
            }
          });
        });
      </script>
    )
  }
</Layout>
