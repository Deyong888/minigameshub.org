---
import { Icon } from 'astro-icon/components';
import type { FableGame } from '~/data/fable-games';

// Full literal Tailwind classes only — never build class names dynamically,
// or Tailwind's purge will drop them.
export const GRADIENTS: Record<string, string> = {
  violet: 'from-violet-600 to-indigo-600',
  sky: 'from-sky-500 to-blue-600',
  emerald: 'from-emerald-500 to-teal-600',
  amber: 'from-amber-500 to-orange-600',
  rose: 'from-rose-500 to-pink-600',
  cyan: 'from-cyan-500 to-sky-600',
  fuchsia: 'from-fuchsia-500 to-purple-600',
  lime: 'from-lime-500 to-green-600',
  slate: 'from-slate-700 to-slate-900',
  indigo: 'from-indigo-600 to-blue-700',
};

export const TOOL_STYLES: Record<string, string> = {
  fable52: 'bg-violet-100 text-violet-800 dark:bg-violet-900/60 dark:text-violet-200',
  fable5: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/60 dark:text-indigo-200',
  opus55: 'bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-200',
  'claude-code': 'bg-orange-100 text-orange-800 dark:bg-orange-900/60 dark:text-orange-200',
  claude: 'bg-stone-100 text-stone-800 dark:bg-stone-700 dark:text-stone-200',
  cursor: 'bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-200',
  codex: 'bg-green-100 text-green-800 dark:bg-green-900/60 dark:text-green-200',
  'cursor-claude': 'bg-teal-100 text-teal-800 dark:bg-teal-900/60 dark:text-teal-200',
  agents: 'bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-200',
  threejs: 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/60 dark:text-cyan-200',
};

interface Props {
  game: FableGame;
  hubUrl?: string;
}

const { game, hubUrl = '/fable-5-2-games' } = Astro.props;
const detailUrl = `${hubUrl}/${game.slug}`;
const gradient = GRADIENTS[game.gradient] ?? GRADIENTS.violet;
const toolStyle = TOOL_STYLES[game.toolKey] ?? TOOL_STYLES.claude;
---

<a
  href={detailUrl}
  class="group flex flex-col bg-white dark:bg-slate-800 rounded-2xl overflow-hidden border border-gray-200 dark:border-slate-700 shadow-sm hover:shadow-xl hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition-all duration-300"
  aria-label={`Play ${game.name} — ${game.genre}, built with ${game.tool}`}
>
  <div class={`relative aspect-video bg-gradient-to-br ${gradient} flex items-center justify-center overflow-hidden`}>
    {
      game.cover ? (
        <>
          <img
            src={game.cover}
            alt=""
            loading="lazy"
            onerror="this.style.display='none'"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/10 pointer-events-none" />
        </>
      ) : (
        <>
          <Icon
            name={`tabler:${game.icon}`}
            class="absolute -right-4 -bottom-6 w-32 h-32 text-white/15 group-hover:scale-110 transition-transform duration-300"
            aria-hidden="true"
          />
          <span class="relative flex items-center justify-center w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-sm ring-1 ring-white/30">
            <Icon name={`tabler:${game.icon}`} class="w-9 h-9 text-white" aria-hidden="true" />
          </span>
        </>
      )
    }
    <span class="absolute top-3 left-3 text-xs font-semibold px-2.5 py-1 bg-black/30 text-white rounded-full backdrop-blur-sm">
      {game.genre}
    </span>
    {
      !game.embeddable && (
        <span class="absolute top-3 right-3 inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 bg-black/30 text-white rounded-full backdrop-blur-sm">
          <Icon name="tabler:external-link" class="w-3.5 h-3.5" aria-hidden="true" />
          Original site
        </span>
      )
    }
  </div>
  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-bold text-lg leading-snug group-hover:text-primary transition-colors">{game.name}</h3>
    </div>
    {
      game.author && (
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
          by {game.author}
          {game.handle && ` (${game.handle})`}
        </p>
      )
    }
    <div class="flex flex-wrap gap-1.5 mt-3">
      <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${toolStyle}`}>{game.tool}</span>
      {
        game.chineseUI && (
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-gray-300">
            Chinese UI
          </span>
        )
      }
      {
        game.license && (
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-gray-300">
            {game.license}
          </span>
        )
      }
    </div>
    <p class="text-sm text-gray-700 dark:text-gray-300 mt-3 line-clamp-3 flex-1">{game.description}</p>
    <span class="inline-flex items-center gap-1.5 mt-4 text-sm font-semibold text-primary">
      {game.embeddable ? 'Play free' : 'Play on the original site'}
      <Icon
        name="tabler:chevron-right"
        class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
        aria-hidden="true"
      />
    </span>
  </div>
</a>
