---
import merge from 'lodash.merge';
import { AstroSeo } from '@astrolib/seo';

import type { Props as AstroSeoProps } from '@astrolib/seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  skipHreflang = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const currentLocale = Astro.currentLocale || I18N?.language || 'en';
const currentPath = Astro.url.pathname;

// og:locale 必须与页面语言一致(此前被 config 中硬编码的 en_US 覆盖)
const ogLocaleMap: Record<string, string> = { en: 'en_US', es: 'es_ES', zh: 'zh_CN' };
const ogLocale = ogLocaleMap[currentLocale] || 'en_US';

// Generate hreflang alternates for every configured locale + x-default.
// Locales mirror astro.config.ts i18n.locales (en/es/zh); default locale has no path prefix.
// 注意：astrowind 的 I18N 配置没有 locales 字段，且 Astro 全局类型无 Astro.locales，
// 故直接对齐 astro.config.ts 的硬编码列表。
const locales: string[] = ['en', 'es', 'zh'];
const getAlternates = () => {
    const alternates: { href: string; hreflang: string }[] = [];

    // Strip any existing locale prefix to get the language-neutral base path.
    const basePath = currentPath.replace(/^\/(?:es|zh)(?=\/|$)/, '') || '/';

    const getLocalePath = (locale: string) => {
        if (locale === 'en') return basePath === '/' ? '/' : basePath;
        const prefix = `/${locale}`;
        return basePath === '/' ? prefix : `${prefix}${basePath}`;
    };

    for (const locale of locales) {
        alternates.push({ href: String(getCanonical(getLocalePath(locale))), hreflang: locale });
    }
    // x-default points to the canonical (English) version
    alternates.push({ href: String(getCanonical(basePath === '/' ? '/' : basePath)), hreflang: 'x-default' });

    return alternates;
};

const languageAlternates = getAlternates();

const seoProps: AstroSeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: currentLocale,
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
    // canonical 收敛到他页时不输出 hreflang,避免"自认语言版本"与 canonical 信号冲突
    languageAlternates: skipHreflang ? [] : languageAlternates,
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    // locale 以当前页面语言为准,覆盖 config 中硬编码的 en_US;页面仍可通过 openGraph.locale 显式覆盖
    openGraph: { url: canonical, locale: ogLocale, ...openGraph },
    twitter: twitter,
  }
);
---

<AstroSeo {...{ ...seoProps, openGraph: await adaptOpenGraphImages(seoProps?.openGraph, Astro.site) }} />
