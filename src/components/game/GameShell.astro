---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getLangFromUrl, useTranslations } from '~/utils/i18n';

// 通用播放器外壳(2026-11-16,外壳方案):
// 只有 isGameIndexable 的游戏(每语种 500 款)有预渲染静态页;其余 6,805 款/语种
// 的 /game/* URL 由 Vercel rewrite 指向各语种的 /play 页(即本组件),前端 JS
// 按 URL 中的游戏 ID 查 /game-index.json 渲染标题/简介/播放器/相关游戏。
// 外壳页本身 noindex、不进 sitemap、不被站内链接;未知 ID 显示友好 404 状态。
// 注意:本页经 rewrite 承接 /game/* 请求,浏览器地址栏仍是 /game/{id}-{slug},
// 因此游戏 ID 必须从 window.location.pathname 解析,不能用 Astro.url。

interface ShellLabels {
  title: string;
  description: string;
  loading: string;
  bossKey: string;
  mute: string;
  unmute: string;
  fullscreen: string;
  bossKeyHint: string;
  returnToGame: string;
  loadingGame: string;
  notFoundTitle: string;
  notFoundText: string;
  browseGames: string;
  about: string;
}

const SHELL_LABELS: Record<string, ShellLabels> = {
  en: {
    title: 'Play Free Online Games | MiniGamesHub',
    description: 'Play free browser games online — no download, no sign-up. Instant play on desktop, Chromebook, and mobile.',
    loading: 'Loading',
    bossKey: 'Boss Key',
    mute: 'Mute',
    unmute: 'Unmute',
    fullscreen: 'Fullscreen',
    bossKeyHint: 'Press ESC for Boss Key',
    returnToGame: 'Press ESC to return to game...',
    loadingGame: 'Loading game…',
    notFoundTitle: 'Game not found',
    notFoundText: 'This game may have been removed, or the link might be wrong.',
    browseGames: 'Browse all games',
    about: 'About',
  },
  es: {
    title: 'Juega Gratis en Línea | MiniGamesHub',
    description: 'Juega gratis en tu navegador — sin descargas ni registros. Juega al instante en ordenador, Chromebook y móvil.',
    loading: 'Cargando',
    bossKey: 'Modo Jefe',
    mute: 'Silenciar',
    unmute: 'Activar Sonido',
    fullscreen: 'Pantalla Completa',
    bossKeyHint: 'Presiona ESC para modo Jefe',
    returnToGame: 'Presiona ESC para volver al juego...',
    loadingGame: 'Cargando el juego…',
    notFoundTitle: 'Juego no encontrado',
    notFoundText: 'Es posible que este juego haya sido eliminado o que el enlace sea incorrecto.',
    browseGames: 'Ver todos los juegos',
    about: 'Acerca de',
  },
  zh: {
    title: '免费在线玩游戏 | MiniGamesHub',
    description: '免费在线玩浏览器游戏，无需下载，无需注册。电脑、Chromebook 和手机都能即开即玩。',
    loading: '正在加载',
    bossKey: '老板键',
    mute: '静音',
    unmute: '开启声音',
    fullscreen: '全屏模式',
    bossKeyHint: '按 ESC 键开启老板键模式',
    returnToGame: '按 ESC 键返回游戏...',
    loadingGame: '正在加载游戏…',
    notFoundTitle: '找不到这款游戏',
    notFoundText: '这款游戏可能已下架，或链接有误。',
    browseGames: '浏览全部游戏',
    about: '关于',
  },
  de: {
    title: 'Kostenlos Online Spielen | MiniGamesHub',
    description: 'Spiele kostenlose Browsergames online — ohne Download, ohne Anmeldung. Sofort spielbar auf Desktop, Chromebook und Handy.',
    loading: 'Wird geladen',
    bossKey: 'Chef-Modus',
    mute: 'Stummschalten',
    unmute: 'Ton an',
    fullscreen: 'Vollbild',
    bossKeyHint: 'Drücke ESC für den Chef-Modus',
    returnToGame: 'Drücke ESC, um zum Spiel zurückzukehren …',
    loadingGame: 'Spiel wird geladen…',
    notFoundTitle: 'Spiel nicht gefunden',
    notFoundText: 'Dieses Spiel wurde möglicherweise entfernt oder der Link ist falsch.',
    browseGames: 'Alle Spiele ansehen',
    about: 'Über',
  },
  pt: {
    title: 'Jogue Grátis Online | MiniGamesHub',
    description: 'Jogue jogos de navegador grátis online — sem download, sem cadastro. Jogue na hora no computador, Chromebook e celular.',
    loading: 'Carregando',
    bossKey: 'Modo chefe',
    mute: 'Silenciar',
    unmute: 'Ativar som',
    fullscreen: 'Tela cheia',
    bossKeyHint: 'Aperte ESC para o modo chefe',
    returnToGame: 'Aperte ESC para voltar ao jogo...',
    loadingGame: 'Carregando o jogo…',
    notFoundTitle: 'Jogo não encontrado',
    notFoundText: 'Este jogo pode ter sido removido ou o link pode estar incorreto.',
    browseGames: 'Ver todos os jogos',
    about: 'Sobre',
  },
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = SHELL_LABELS[lang] ?? SHELL_LABELS.en;
const localePrefix = lang === 'en' ? '' : `/${lang}`;
const homeHref = lang === 'en' ? '/' : `/${lang}/`;

// 传给客户端脚本的全部文案(构建时序列化,运行时不再依赖服务端)
const labels = {
  ...L,
  home: t('nav.home'),
  similar: t('game.similar'),
  playGame: t('game.play'),
};

const metadata = {
  title: L.title,
  ignoreTitleTemplate: true,
  description: L.description,
  // 外壳页是 rewrite 承接页,noindex、不进 sitemap
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <div id="game-shell" data-pagefind-ignore>
    <WidgetWrapper id="game-player" containerClass="max-w-7xl mx-auto py-6" bg="<div class='absolute inset-0 bg-blue-50 dark:bg-transparent'></div>">
      <!-- Breadcrumbs (filled by client script once the game resolves) -->
      <nav class="flex mb-4" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href={homeHref} class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
              <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
              </svg>
              {labels.home}
            </a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <a id="shell-crumb-category" href={homeHref} class="ml-1 text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white md:ml-2">…</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span id="shell-crumb-title" class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">…</span>
            </div>
          </li>
        </ol>
      </nav>

      <div id="shell-main" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Game Area (2/3 width) -->
        <div class="lg:col-span-2">
          <div class="game-player" id="shell-player">
            <div class="game-frame-wrapper relative">
              <iframe
                id="shell-frame"
                data-src=""
                title=""
                width="100%"
                height="100%"
                allowfullscreen
                allow="autoplay; fullscreen; clipboard-write"
                sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
                loading="lazy"
                tabindex="-1"
                aria-hidden="true"
                class="game-frame rounded-lg shadow-2xl opacity-0"></iframe>

              <!-- Poster + click-to-play (hidden until the game resolves) -->
              <button
                type="button"
                id="shell-poster"
                class="game-poster absolute inset-0 hidden items-center justify-center bg-gray-900 rounded-lg border-0 p-0"
                aria-label=""
              >
                <img
                  id="shell-poster-img"
                  src=""
                  alt=""
                  width="960"
                  height="540"
                  fetchpriority="high"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover rounded-lg"
                />
                <span class="play-badge relative z-10 flex items-center justify-center w-20 h-20 rounded-full bg-white/90 text-primary shadow-xl">
                  <svg viewBox="0 0 24 24" class="w-9 h-9 ml-1" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </button>

              <!-- Loading state (visible until the game resolves) -->
              <div id="shell-loading" class="loading-overlay absolute inset-0 flex items-center justify-center bg-gray-900 rounded-lg">
                <div class="text-center">
                  <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-white mx-auto"></div>
                  <p id="shell-loading-text" class="mt-4 text-white">{L.loadingGame}</p>
                </div>
              </div>
            </div>

            <div class="player-controls mt-4 flex flex-wrap gap-2 items-center justify-between bg-gray-800 p-3 rounded-lg">
              <div class="flex gap-2">
                <button
                  id="boss-key-btn"
                  class="boss-key-btn bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded flex items-center gap-2 transition-colors"
                  title={L.bossKeyHint}
                >
                  <span>🚨</span>
                  <span>{L.bossKey}</span>
                </button>

                <button
                  id="mute-btn"
                  class="mute-btn bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded flex items-center gap-2 transition-colors"
                  title="Mute (M)"
                >
                  <span id="mute-icon">🔊</span>
                  <span id="mute-text">{L.mute}</span>
                </button>

                <button
                  id="fullscreen-btn"
                  class="fullscreen-btn bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded flex items-center gap-2 transition-colors"
                  title="Fullscreen (F)"
                >
                  <span>⛶</span>
                  <span>{L.fullscreen}</span>
                </button>
              </div>

              <div
                class="text-gray-300 text-sm"
                set:html={L.bossKeyHint.replace('ESC', '<kbd class="bg-gray-700 px-2 py-1 rounded">ESC</kbd>')}
              />
            </div>
          </div>

          <!-- Game Controls / Info Bar -->
          <div class="flex items-center justify-between bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm mb-6 mt-4">
            <div>
              <h1 id="shell-title" class="text-2xl font-bold text-gray-900 dark:text-white">…</h1>
            </div>
            <div class="flex gap-2">
              <button id="shell-favoriteBtn" class="btn-secondary px-3 py-1.5 text-sm rounded border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">🤍 Favorite</button>
              <button id="shell-shareBtn" class="btn-secondary px-3 py-1.5 text-sm rounded border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">🔗 Share</button>
            </div>
          </div>

          <!-- Game Description -->
          <div class="prose dark:prose-invert max-w-none bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
            <h2 id="shell-about">…</h2>
            <p id="shell-desc">…</p>
          </div>
        </div>

        <!-- Sidebar (1/3 width) -->
        <div class="lg:col-span-1">
          <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm sticky top-24">
            <h3 class="font-bold text-lg mb-4 border-b pb-2">{labels.similar}</h3>
            <div id="shell-related" class="flex flex-col gap-4"></div>
          </div>
        </div>
      </div>

      <!-- Not found state (unknown game id or missing slug) -->
      <div id="shell-notfound" class="hidden text-center py-16">
        <p class="text-6xl mb-4">🎮</p>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">{L.notFoundTitle}</h1>
        <p class="text-gray-600 dark:text-gray-400 mb-6">{L.notFoundText}</p>
        <a href={homeHref} class="inline-block bg-primary text-white px-6 py-2.5 rounded-lg hover:opacity-90 transition-opacity">{L.browseGames}</a>
      </div>
      <!-- Boss key overlay (hidden by default; same fake-Excel UI as GamePlayer) -->
      <div id="boss-overlay" class="boss-overlay hidden fixed inset-0 bg-gray-100 z-50 overflow-auto">
        <div class="max-w-5xl mx-auto p-8">
          <div class="bg-white shadow-lg min-h-screen">
            <div class="bg-green-700 text-white px-4 py-2 flex items-center justify-between">
              <span>Q3_Financial_Report.xlsx - Excel</span>
              <div class="flex gap-2">
                <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                <span class="w-3 h-3 rounded-full bg-green-400"></span>
              </div>
            </div>
            <div class="p-4">
              <div class="border border-gray-300">
                <table class="w-full text-sm">
                  <thead class="bg-gray-100">
                    <tr>
                      <th class="border p-2 text-left">Revenue Stream</th>
                      <th class="border p-2 text-right">Q1</th>
                      <th class="border p-2 text-right">Q2</th>
                      <th class="border p-2 text-right">Q3</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td class="border p-2">Product Sales</td><td class="border p-2 text-right">$1.2M</td><td class="border p-2 text-right">$1.5M</td><td class="border p-2 text-right">$1.8M</td></tr>
                    <tr><td class="border p-2">Services</td><td class="border p-2 text-right">$800K</td><td class="border p-2 text-right">$900K</td><td class="border p-2 text-right">$1.1M</td></tr>
                  </tbody>
                </table>
              </div>
              <p
                class="mt-8 text-gray-500 text-center"
                set:html={L.returnToGame.replace('ESC', '<kbd class="bg-gray-200 px-2 py-1 rounded">ESC</kbd>')}
              />
            </div>
          </div>
        </div>
      </div>
    </WidgetWrapper>
  </div>
</Layout>

<script type="application/json" id="shell-labels" set:html={JSON.stringify({ labels, localePrefix }).replace(/</g, '\\u003c')} />
<script is:inline>
  // Game shell client logic (see the header comment in this file).
  // Served via Vercel rewrite for every /game/* URL without a pre-rendered
  // page. Astro view transitions: this inline script may re-execute on every
  // navigation, or be deduped by the router — either way init runs via the
  // immediate call AND the astro:page-load listener, guarded by a dataset
  // flag on the shell root (fresh element per navigation => re-init works).
  // Everything lives inside an IIFE so re-execution never re-declares
  // globals; labels come from the JSON island above, never define:vars
  // (whose top-level const would throw "already declared" on re-execution).
  (function () {
    let cfg = null;

    function shellData() {
      const el = document.getElementById('shell-labels');
      if (!el) return null;
      try {
        return JSON.parse(el.textContent || '{}');
      } catch {
        return null;
      }
    }

    function shellLoadIndex() {
      if (window.__mghGameIndexPromise) return window.__mghGameIndexPromise;
      const p = fetch('/game-index.json')
        .then(function (res) {
          if (!res.ok) throw new Error('game index fetch failed');
          return res.json();
        })
        .then(function (data) {
          return Array.isArray(data) ? data : [];
        });
      window.__mghGameIndexPromise = p;
      p.catch(function () {
        window.__mghGameIndexPromise = null;
      });
      return p;
    }

    function shellShowNotFound() {
      const main = document.getElementById('shell-main');
      const nf = document.getElementById('shell-notfound');
      if (main) main.classList.add('hidden');
      if (nf) nf.classList.remove('hidden');
      const title = cfg && cfg.labels ? cfg.labels.notFoundTitle : 'Game not found';
      document.title = title + ' | MiniGamesHub';
    }

    function shellCategorySlug(category) {
      return (category || 'Games').toLowerCase().replace(/\s+/g, '-');
    }

    // GamePix embed URL pattern, verified against all 7,305 feed items:
    // https://play.gamepix.com/{namespace}/embed?sid=GM8A7 (slug = namespace).
    function shellEmbedUrl(game) {
      return 'https://play.gamepix.com/' + game.slug + '/embed?sid=GM8A7';
    }

    function shellAddToHistory(id) {
      try {
        let history = JSON.parse(localStorage.getItem('bg_history') || '[]');
        history = history.filter(function (item) {
          return item !== id;
        });
        history.unshift(id);
        if (history.length > 20) history.pop();
        localStorage.setItem('bg_history', JSON.stringify(history));
      } catch {
        /* private mode */
      }
    }

    function shellWirePlayer(game, pageTitle) {
      const labels = cfg.labels;
      const frame = document.getElementById('shell-frame');
      const poster = document.getElementById('shell-poster');
      const loading = document.getElementById('shell-loading');
      const bossOverlay = document.getElementById('boss-overlay');
      const bossBtn = document.getElementById('boss-key-btn');
      const muteBtn = document.getElementById('mute-btn');
      const muteIcon = document.getElementById('mute-icon');
      const muteText = document.getElementById('mute-text');
      const fullscreenBtn = document.getElementById('fullscreen-btn');

      let started = false;
      let isBossMode = false;
      let isMuted = false;

      function startGame() {
        if (started) return;
        started = true;
        if (loading) loading.classList.remove('hidden');
        if (frame && frame.dataset.src) frame.src = frame.dataset.src;
      }
      if (poster) poster.addEventListener('click', startGame);
      if (frame) {
        frame.addEventListener('load', function () {
          if (loading) loading.classList.add('hidden');
          frame.classList.remove('opacity-0');
          if (poster) poster.classList.add('hidden');
        });
      }

      function toggleBossMode() {
        isBossMode = !isBossMode;
        if (!bossOverlay) return;
        if (isBossMode) {
          bossOverlay.classList.remove('hidden');
          document.title = 'Q3_Financial_Report.xlsx - Excel Online';
          try {
            frame.contentWindow?.postMessage({ type: 'mute', value: true }, '*');
          } catch {
            /* cross-origin iframe */
          }
        } else {
          bossOverlay.classList.add('hidden');
          document.title = pageTitle;
          try {
            frame.contentWindow?.postMessage({ type: 'mute', value: false }, '*');
          } catch {
            /* cross-origin iframe */
          }
        }
      }
      if (bossBtn) bossBtn.addEventListener('click', toggleBossMode);

      function toggleMute() {
        isMuted = !isMuted;
        if (muteIcon) muteIcon.textContent = isMuted ? '🔇' : '🔊';
        if (muteText) muteText.textContent = isMuted ? labels.unmute : labels.mute;
        try {
          frame.contentWindow?.postMessage({ type: 'audio', action: isMuted ? 'mute' : 'unmute' }, '*');
        } catch {
          /* cross-origin iframe */
        }
        if (muteBtn) {
          muteBtn.classList.toggle('bg-red-600', isMuted);
          muteBtn.classList.toggle('bg-gray-600', !isMuted);
        }
      }
      if (muteBtn) muteBtn.addEventListener('click', toggleMute);

      function toggleFullscreen() {
        if (!document.fullscreenElement) {
          if (frame && frame.requestFullscreen) void frame.requestFullscreen();
        } else {
          void document.exitFullscreen();
        }
      }
      if (fullscreenBtn) fullscreenBtn.addEventListener('click', toggleFullscreen);

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' || e.key === '`') {
          e.preventDefault();
          toggleBossMode();
        }
        if (!started) return;
        if (e.key === 'm' || e.key === 'M') toggleMute();
        if (e.key === 'f' || e.key === 'F') toggleFullscreen();
      });
    }

    function shellWireFavoriteShare(game) {
      const favBtn = document.getElementById('shell-favoriteBtn');
      if (favBtn) {
        const readFavs = function () {
          try {
            return JSON.parse(localStorage.getItem('bg_favorites') || '[]');
          } catch {
            return [];
          }
        };
        const updateFav = function () {
          const isFav = readFavs().indexOf(game.slug) > -1;
          favBtn.textContent = isFav ? '❤️ Saved' : '🤍 Favorite';
          favBtn.classList.toggle('text-pink-600', isFav);
          favBtn.classList.toggle('border-pink-200', isFav);
          favBtn.classList.toggle('bg-pink-50', isFav);
        };
        favBtn.onclick = function () {
          const favs = readFavs();
          const idx = favs.indexOf(game.slug);
          if (idx > -1) favs.splice(idx, 1);
          else favs.push(game.slug);
          try {
            localStorage.setItem('bg_favorites', JSON.stringify(favs));
          } catch {
            /* private mode */
          }
          updateFav();
        };
        updateFav();
      }
      const shareBtn = document.getElementById('shell-shareBtn');
      if (shareBtn) {
        shareBtn.onclick = function () {
          if (navigator.share) {
            navigator.share({ title: document.title, url: window.location.href }).catch(function () {});
          } else if (navigator.clipboard) {
            navigator.clipboard
              .writeText(window.location.href)
              .then(function () {
                const original = shareBtn.textContent;
                shareBtn.textContent = '✅ Copied!';
                setTimeout(function () {
                  shareBtn.textContent = original;
                }, 2000);
              })
              .catch(function () {});
          }
        };
      }
    }

    function shellRenderRelated(game, games) {
      const wrap = document.getElementById('shell-related');
      if (!wrap) return;
      wrap.innerHTML = '';
      let count = 0;
      for (let i = 0; i < games.length && count < 6; i++) {
        const g = games[i];
        if (g.id === game.id || g.category !== game.category) continue;
        count++;
        const a = document.createElement('a');
        a.href = cfg.localePrefix + '/game/' + g.id + '-' + g.slug;
        a.className = 'flex gap-3 group';
        const img = document.createElement('img');
        img.src = g.thumbnail || '';
        img.alt = g.title;
        img.loading = 'lazy';
        img.className = 'w-20 h-14 object-cover rounded bg-gray-200';
        const div = document.createElement('div');
        const h4 = document.createElement('h4');
        h4.className = 'font-bold text-sm group-hover:text-primary line-clamp-2';
        h4.textContent = g.title;
        const span = document.createElement('span');
        span.className = 'text-xs text-gray-500';
        span.textContent = g.category || '';
        div.appendChild(h4);
        div.appendChild(span);
        a.appendChild(img);
        a.appendChild(div);
        wrap.appendChild(a);
      }
    }

    function shellRenderGame(game, games) {
      const labels = cfg.labels;
      const category = game.category || 'Games';
      const categorySlug = shellCategorySlug(category);
      const pageTitle = game.title + ' - Play Free Online | No Download | MiniGamesHub';
      document.title = pageTitle;

      const metaDesc = document.querySelector('meta[name="description"]');
      if (metaDesc) {
        metaDesc.setAttribute(
          'content',
          'Play ' +
            game.title +
            ' free in your browser — no download, no sign-up. A ' +
            category +
            ' game on MiniGamesHub, playable instantly on desktop, Chromebook, and mobile.'
        );
      }

      const crumbCat = document.getElementById('shell-crumb-category');
      if (crumbCat) {
        crumbCat.textContent = category;
        crumbCat.href = cfg.localePrefix + '/category/' + categorySlug;
      }
      const crumbTitle = document.getElementById('shell-crumb-title');
      if (crumbTitle) crumbTitle.textContent = game.title;
      const h1 = document.getElementById('shell-title');
      if (h1) h1.textContent = game.title;
      const about = document.getElementById('shell-about');
      if (about) about.textContent = labels.about + ' ' + game.title;
      const desc = document.getElementById('shell-desc');
      if (desc) {
        desc.textContent =
          game.description ||
          'Play ' + game.title + ' free online, right in your browser — no download and no sign-up required.';
      }

      const frame = document.getElementById('shell-frame');
      const poster = document.getElementById('shell-poster');
      const posterImg = document.getElementById('shell-poster-img');
      const loading = document.getElementById('shell-loading');
      const loadingText = document.getElementById('shell-loading-text');
      if (frame) {
        frame.dataset.src = shellEmbedUrl(game);
        frame.title = game.title + ' - Play Online Free';
      }
      if (poster) {
        poster.setAttribute('aria-label', game.title + ' — ' + labels.playGame);
        poster.classList.remove('hidden');
        poster.classList.add('flex');
      }
      if (posterImg) {
        posterImg.src = game.thumbnail || '';
        posterImg.alt = game.title + ' — game cover';
      }
      if (loadingText) loadingText.textContent = labels.loading + ' ' + game.title + '...';
      if (loading) loading.classList.add('hidden');

      shellRenderRelated(game, games);
      shellWirePlayer(game, pageTitle);
      shellWireFavoriteShare(game);
      shellAddToHistory(game.id);
    }

    function initGameShell() {
      // Fresh lookup every time: the script may run once per page (deduped
      // router) or once per navigation (re-executed) — either way the root
      // element here is the current page's, and its dataset flag guards
      // against double-init within one page.
      const root = document.getElementById('game-shell');
      if (!root || root.dataset.shellInit) return;
      root.dataset.shellInit = '1';
      cfg = shellData();
      if (!cfg || !cfg.labels) {
        shellShowNotFound();
        return;
      }
      const m = window.location.pathname.match(/\/game\/([^-/]+)-([^/?#]+)/);
      if (!m) {
        shellShowNotFound();
        return;
      }
      const gameId = m[1];
      shellLoadIndex()
        .then(function (games) {
          // The user may have navigated away while the index was loading.
          const m2 = window.location.pathname.match(/\/game\/([^-/]+)-([^/?#]+)/);
          if (!m2 || m2[1] !== gameId) return;
          let game = null;
          for (let i = 0; i < games.length; i++) {
            if (games[i].id === gameId) {
              game = games[i];
              break;
            }
          }
          if (!game) {
            shellShowNotFound();
            return;
          }
          shellRenderGame(game, games);
        })
        .catch(function () {
          shellShowNotFound();
        });
    }

    initGameShell();
    document.addEventListener('astro:page-load', initGameShell);
  })();
</script>


