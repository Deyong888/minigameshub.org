---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { featuredGames, allGames, getUniqueCategories } from '~/data/games';

const metadata = {
  title: 'Search Games — MiniGamesHub',
  description:
    'Search 3,900+ free games on MiniGamesHub. Find arcade, puzzle, racing, sports and more — play instantly in your browser, no download, no sign-up.',
};

const popularGames = (() => {
  const seen = new Set<string>();
  const out: typeof featuredGames = [];
  for (const g of [...featuredGames, ...allGames]) {
    if (seen.has(g.id)) continue;
    seen.add(g.id);
    out.push(g);
    if (out.length >= 12) break;
  }
  return out;
})();

const popularCategories = getUniqueCategories().slice(0, 10);
const categorySlug = (c: string) => c.toLowerCase().replace(/\s+/g, '-');
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="text-center mb-10 max-w-2xl mx-auto">
      <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4">Search Games</h1>
      <p class="text-xl text-muted">Search 3,900+ free games — instant play, no download, no sign-up.</p>
    </div>

    <form id="search-form" action="/search" method="get" class="max-w-xl mx-auto mb-8" role="search">
      <div class="flex items-center gap-2 rounded-full bg-white dark:bg-slate-800 shadow-lg ring-1 ring-gray-200 dark:ring-slate-700 px-2 py-2">
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="Search 3,900+ free games…"
          autocomplete="off"
          autofocus
          class="flex-1 min-w-0 bg-transparent px-4 py-2 text-base text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none"
        />
        <button
          type="submit"
          class="shrink-0 rounded-full bg-primary hover:bg-primary/90 text-white font-semibold px-6 py-2.5 transition-colors"
        >
          Search
        </button>
      </div>
    </form>

    <div class="flex flex-wrap justify-center gap-2 mb-12">
      {
        popularCategories.map((c) => (
          <a
            href={`/category/${categorySlug(c)}`}
            class="px-3 py-1.5 rounded-full bg-gray-100 dark:bg-slate-800 text-sm capitalize hover:bg-primary hover:text-white transition-colors"
          >
            {c}
          </a>
        ))
      }
    </div>

    <p id="search-status" class="text-center text-muted mb-6" aria-live="polite"></p>

    <div id="search-results-wrap" class="hidden">
      <div
        id="search-results"
        class="grid gap-6 md:gap-8 row-gap-5 grid-cols-2 md:grid-cols-3 lg:grid-cols-6 max-w-7xl mx-auto"
      >
      </div>
      <div id="search-empty" class="hidden text-center py-16">
        <p id="search-empty-text" class="text-xl font-semibold mb-4"></p>
        <p class="text-muted mb-4">Try one of these popular searches:</p>
        <div class="flex flex-wrap justify-center gap-2">
          {
            popularCategories.slice(0, 6).map((c) => (
              <a
                href={`/category/${categorySlug(c)}`}
                class="px-3 py-1.5 rounded-full bg-gray-100 dark:bg-slate-800 text-sm capitalize hover:bg-primary hover:text-white transition-colors"
              >
                {c}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div id="popular-section">
      <GameGrid games={popularGames} title="Popular Games" />
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var input = document.getElementById('search-input');
    var form = document.getElementById('search-form');
    var statusEl = document.getElementById('search-status');
    var resultsWrap = document.getElementById('search-results-wrap');
    var resultsEl = document.getElementById('search-results');
    var emptyEl = document.getElementById('search-empty');
    var emptyText = document.getElementById('search-empty-text');
    var popularSection = document.getElementById('popular-section');
    if (!input || !resultsEl || !resultsWrap) return;

    var indexCache = null;
    var indexPromise = null;
    var debounceTimer = null;

    function loadIndex() {
      if (indexCache) return Promise.resolve(indexCache);
      if (!indexPromise) {
        indexPromise = fetch('/game-index.json')
          .then(function (res) {
            if (!res.ok) throw new Error('Failed to load game index');
            return res.json();
          })
          .then(function (data) {
            indexCache = Array.isArray(data) ? data : [];
            return indexCache;
          })
          .catch(function () {
            indexPromise = null;
            return [];
          });
      }
      return indexPromise;
    }

    function createCard(game) {
      var article = document.createElement('article');
      article.className = 'game-card group';
      article.setAttribute('data-game-id', String(game.id));
      article.setAttribute('data-category', String(game.category || ''));

      var link = document.createElement('a');
      link.href = '/game/' + game.id + '-' + game.slug;
      link.className = 'block relative overflow-hidden rounded-xl bg-gray-800 transition-transform hover:scale-105';

      var thumbWrap = document.createElement('div');
      thumbWrap.className = 'aspect-[4/3] relative overflow-hidden';
      var img = document.createElement('img');
      img.src = game.thumbnail || '';
      img.alt = game.title || '';
      img.width = 300;
      img.height = 225;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.className = 'w-full h-full object-cover transition-transform group-hover:scale-110';
      thumbWrap.appendChild(img);
      link.appendChild(thumbWrap);

      var info = document.createElement('div');
      info.className = 'p-3';
      var h3 = document.createElement('h3');
      h3.className = 'text-white font-semibold truncate group-hover:text-green-400 transition-colors';
      h3.textContent = game.title || '';
      info.appendChild(h3);
      var meta = document.createElement('div');
      meta.className = 'flex items-center justify-between mt-2 text-sm text-gray-400';
      var cat = document.createElement('span');
      cat.className = 'capitalize';
      cat.textContent = game.category || '';
      meta.appendChild(cat);
      info.appendChild(meta);
      link.appendChild(info);

      article.appendChild(link);
      return article;
    }

    function render(query, games) {
      resultsEl.textContent = '';
      if (!games.length) {
        resultsWrap.classList.remove('hidden');
        popularSection && popularSection.classList.add('hidden');
        emptyEl && emptyEl.classList.remove('hidden');
        if (emptyText) emptyText.textContent = 'No games found for \u201c' + query + '\u201d';
        if (statusEl) statusEl.textContent = '';
        return;
      }
      emptyEl && emptyEl.classList.add('hidden');
      resultsWrap.classList.remove('hidden');
      popularSection && popularSection.classList.add('hidden');
      var frag = document.createDocumentFragment();
      games.forEach(function (g) {
        frag.appendChild(createCard(g));
      });
      resultsEl.appendChild(frag);
      if (statusEl) {
        statusEl.textContent = games.length + (games.length === 1 ? ' game found for \u201c' : ' games found for \u201c') + query + '\u201d';
      }
    }

    function runSearch(raw) {
      var query = (raw || '').trim();
      if (!query) {
        resultsWrap.classList.add('hidden');
        popularSection && popularSection.classList.remove('hidden');
        if (statusEl) statusEl.textContent = '';
        return;
      }
      if (statusEl) statusEl.textContent = 'Searching…';
      loadIndex().then(function (all) {
        var q = query.toLowerCase();
        var scored = [];
        for (var i = 0; i < all.length; i++) {
          var g = all[i];
          var title = (g.title || '').toLowerCase();
          var cat = (g.category || '').toLowerCase();
          var score = -1;
          if (title.indexOf(q) === 0) score = 0;
          else if (title.indexOf(q) !== -1) score = 1;
          else if (cat.indexOf(q) !== -1) score = 2;
          if (score >= 0) scored.push({ game: g, score: score });
        }
        scored.sort(function (a, b) {
          if (a.score !== b.score) return a.score - b.score;
          return String(a.game.title).localeCompare(String(b.game.title));
        });
        render(query, scored.slice(0, 60).map(function (s) { return s.game; }));
      });
    }

    var params = new URLSearchParams(window.location.search);
    var initialQ = params.get('q') || '';
    if (initialQ) {
      input.value = initialQ;
      runSearch(initialQ);
    }

    input.addEventListener('focus', function () {
      loadIndex();
    });
    input.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function () {
        runSearch(input.value);
      }, 150);
    });
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        runSearch(input.value);
      });
    }
  })();
</script>
