---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import {
  thanksgivingHarvestGames,
  thanksgiving2PlayerGames,
  thanksgivingCookingGames,
  thanksgivingClassicsGames,
  thanksgivingHubGames,
} from '~/data/games';

const metadata = {
  title: 'Thanksgiving Games 2026 - Free Family Browser Games Online',
  description:
    'Play the best free Thanksgiving games online for 2026 — turkey runners, fall puzzles, same-keyboard 2-player showdowns, cooking chaos, and timeless board & card classics. No downloads, no sign-up, instant play.',
};

const faqs = [
  {
    question: 'What are the best free Thanksgiving games to play online in 2026?',
    answer:
      'Our top picks for Thanksgiving 2026 are Turkey Adventure Runner and Thanksgiving Squad Style for holiday flavor, Drunken Duel and 12 MiniBattles for same-keyboard family showdowns, Cooking Madness for kitchen chaos, and Ludo Legend plus 4 Colors Multiplayer for the whole table. Every game on this page is free and plays instantly in your browser.',
  },
  {
    question: 'Are these Thanksgiving games really free? Do I need to download anything?',
    answer:
      'Yes — 100% free, with no downloads, installs, or sign-up. These are HTML5 browser games, so they run instantly in Chrome, Edge, Firefox, or Safari on any device.',
  },
  {
    question: 'Can I play these Thanksgiving games on a Chromebook or at school?',
    answer:
      'Yes. All of the games above are lightweight HTML5 titles that run well on Chromebooks and school or work computers — just open the page and play, no plugins required.',
  },
  {
    question: 'Do you have Thanksgiving games that are good for kids and families?',
    answer:
      'Plenty. The 2-player showdowns (Drunken Duel, Red Hands) run on one keyboard so the whole family can crowd around a single laptop, the board and card classics are easy for grandparents to pick up, and the cozy solo puzzles are perfect for winding down after the feast.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Thanksgiving Games 2026',
      description: metadata.description,
      url: 'https://minigameshub.org/thanksgiving-games',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: thanksgivingHubGames.map((game, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'VideoGame',
            name: game.title,
            url: `https://minigameshub.org/game/${game.id}-${game.slug}`,
            image: game.thumbnail,
            description: game.description,
            genre: game.category,
            playMode: 'SinglePlayer',
            applicationCategory: 'Game',
          },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a
            href="/"
            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white"
          >
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z" />
            </svg>
            Home
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Thanksgiving Games</span>
          </div>
        </li>
      </ol>
    </nav>

    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 text-center">
      Thanksgiving Games 2026
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Family showdowns, cooking chaos, and harvest fun — free to play in your browser, no downloads.
    </p>

    <div class="prose prose-lg dark:prose-invert max-w-none mb-12 text-gray-700 dark:text-gray-300">
      <p>
        Thanksgiving 2026 falls on Thursday, November 26 — and between the cooking, the parade, and the
        post-dinner food coma, every family hits the same gap: cousins staring at phones, uncles asking for
        the Wi-Fi password, and kids asking "what do we do now" before the pie is even served. This hub
        collects the best free Thanksgiving games on MiniGamesHub: turkey runners and harvest puzzles dressed
        for the holiday, same-keyboard 2-player showdowns the whole table can crowd around, cooking games for
        the holiday kitchen crowd, and timeless board and card classics. Every game below runs instantly in
        your browser — on desktop, Chromebook, tablet, or phone.
      </p>
      <p>
        The {thanksgivingHubGames.length} picks below are the ones we'd hand to a friend first. Want more?
        Browse the full <a href="/category/two-player" class="text-primary hover:underline">2-player shelf</a>,
        fire up the <a href="/category/cooking" class="text-primary hover:underline">cooking category</a>, or
        explore thousands more titles in <a href="/mini-games" class="text-primary hover:underline">Mini Games</a>.
      </p>
    </div>

    <!-- Section quick links -->
    <div class="flex flex-wrap justify-center gap-2 mb-4">
      <a href="#harvest-games" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Thanksgiving &amp; Harvest Picks</a>
      <a href="#family-2-player" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Family 2-Player Showdowns</a>
      <a href="#cooking-chaos" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Cooking Chaos</a>
      <a href="#classics" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Board, Card &amp; Cozy Classics</a>
    </div>

    <GameGrid
      id="harvest-games"
      title="Thanksgiving & Harvest Picks"
      subtitle="Turkey runners, fall fashion, and harvest puzzles dressed for the holiday"
      games={thanksgivingHarvestGames}
    />

    <GameGrid
      id="family-2-player"
      title="Family 2-Player Showdowns"
      subtitle="Same-keyboard battles for the whole table — no extra controllers needed"
      games={thanksgiving2PlayerGames}
    />

    <GameGrid
      id="cooking-chaos"
      title="Cooking Chaos"
      subtitle="Run a virtual kitchen at full Thanksgiving-rush speed"
      games={thanksgivingCookingGames}
    />

    <GameGrid
      id="classics"
      title="Board, Card & Cozy Classics"
      subtitle="Timeless table games and quiet solo wind-downs for after the feast"
      games={thanksgivingClassicsGames}
    />

    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700 max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-8">Thanksgiving Games — FAQ</h2>
      <div class="space-y-6 text-gray-700 dark:text-gray-300">
        {faqs.map((faq) => (
          <div>
            <p class="font-bold text-gray-900 dark:text-white mb-1">{faq.question}</p>
            <p>{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-2xl font-bold text-center mb-8">Keep Playing</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/12-scary-halloween-browser-games-2026-play-free-no-download" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Missed Halloween?</h3>
          <p class="text-sm text-gray-500">15 scary browser games from the Halloween collection — still free, still instant.</p>
        </a>
        <a href="/christmas-games" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Christmas Games</h3>
          <p class="text-sm text-gray-500">Next up on the holiday calendar: Santa adventures, festive puzzles, winter sports.</p>
        </a>
        <a href="/new-games" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">New Games</h3>
          <p class="text-sm text-gray-500">Freshly added browser games, updated as new titles land.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
