---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { smallQuickGames } from '~/data/games';

const metadata = {
  title: 'Jogos pequenos rápidos – Jogo instantâneo',
  description: 'Pule para a ação com jogos pequenos rápidos. Sem espera, só jogar.',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Jogos pequenos rápidos",
  "description": metadata.description,
  "url": "https://minigameshub.org/pt/small-games/quick",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": smallQuickGames.map((game, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "VideoGame",
        "name": game.title,
        "url": `https://minigameshub.org/game/${game.slug}`,
        "image": game.thumbnail,
        "description": game.description,
        "genre": game.category,
        "playMode": "SinglePlayer",
        "applicationCategory": "Game"
      }
    }))
  }
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/pt/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Início
          </a>
        </li>
        <li class="inline-flex items-center">
          <a href="/pt/small-games" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            Jogos pequenos
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Rápidos</span>
          </div>
        </li>
      </ol>
    </nav>

    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 font-heading text-center">
      Jogos pequenos rápidos
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Jogos feitos para sessões rápidas.
    </p>
    <GameGrid games={smallQuickGames} />

    <div class="mt-16 prose dark:prose-invert max-w-none">
      <h2>Velocidade e ação instantânea</h2>
      <p>
        Para os jogadores que valorizam a velocidade, nossos jogos pequenos rápidos são a escolha ideal. Esses títulos são otimizados para começar na hora, com doses rápidas de entretenimento sem tempos de carregamento perceptíveis.
      </p>
      <h3>Por que escolher jogos rápidos</h3>
      <ul>
        <li><strong>Sem espera:</strong> Otimizados para carregamento instantâneo.</li>
        <li><strong>Ritmo acelerado:</strong> Feitos para te prender desde o primeiro segundo.</li>
        <li><strong>Ideal para celular:</strong> Perfeitos para jogar em movimento.</li>
      </ul>
    </div>
  </section>
</Layout>
