---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { miniPuzzleGames } from '~/data/games';

const metadata = {
  title: 'Minijogos de quebra-cabeça – Enigmas e lógica',
  description: 'Desafie sua mente com nossa coleção de minijogos de quebra-cabeça. Sudoku, 2048, Match-3 e mais.',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Minijogos de quebra-cabeça",
  "description": metadata.description,
  "url": "https://minigameshub.org/pt/mini-games/puzzle",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": miniPuzzleGames.map((game, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "VideoGame",
        "name": game.title,
        "url": `https://minigameshub.org/pt/game/${game.id}-${game.slug}`,
        "image": game.thumbnail,
        "description": game.description,
        "genre": game.category,
        "playMode": "SinglePlayer",
        "applicationCategory": "Game"
      }
    }))
  }
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/pt/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Início
          </a>
        </li>
        <li class="inline-flex items-center">
          <a href="/pt/mini-games" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            Minijogos
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Quebra-cabeça</span>
          </div>
        </li>
      </ol>
    </nav>
    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 font-heading text-center">
      Minijogos de quebra-cabeça
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Enigmas, quebra-cabeças lógicos e desafios mentais.
    </p>
    <GameGrid games={miniPuzzleGames} />

    <div class="mt-16 prose dark:prose-invert max-w-none">
      <h2>Treine seu cérebro</h2>
      <p>
        Mantenha sua mente afiada com nossos minijogos de quebra-cabeça. Da lógica matemática ao reconhecimento de padrões, esses jogos oferecem um treino mental rápido e divertido.
      </p>
      <h3>Benefícios dos quebra-cabeças</h3>
      <ul>
        <li><strong>Estímulo mental:</strong> Melhora a concentração e a memória.</li>
        <li><strong>Resolução de problemas:</strong> Desenvolve o pensamento lógico.</li>
        <li><strong>Relaxamento produtivo:</strong> Desligue a mente enquanto exercita o cérebro.</li>
      </ul>
    </div>
  </section>
</Layout>
