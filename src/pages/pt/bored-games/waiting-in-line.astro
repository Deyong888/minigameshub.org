---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { waitingInLineGames } from '~/data/games';

const metadata = {
  title: 'Jogos para esperar na fila – Jogue na hora',
  description: 'Entediado esperando na fila? Jogue esses jogos rápidos de uma mão na hora. Sem downloads. Perfeitos para passar o tempo nas filas.',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Jogos para esperar na fila",
  "description": metadata.description,
  "url": "https://minigameshub.org/pt/bored-games/waiting-in-line",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": waitingInLineGames.map((game, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "VideoGame",
        "name": game.title,
        "url": `https://minigameshub.org/game/${game.slug}`,
        "image": game.thumbnail,
        "description": game.description,
        "genre": game.category,
        "playMode": "SinglePlayer",
        "applicationCategory": "Game"
      }
    }))
  }
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/pt/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Início
          </a>
        </li>
        <li class="inline-flex items-center">
          <a href="/pt/bored-games" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            Jogos contra o tédio
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Esperando na fila</span>
          </div>
        </li>
      </ol>
    </nav>
    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-8 md:mb-12 font-heading text-center">
      Jogos para esperar na fila
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Não fique aí parado! Jogue esses jogos rápidos de uma mão enquanto espera.
    </p>
    
    <GameGrid games={waitingInLineGames} />

    <div class="mt-16 prose dark:prose-invert max-w-none">
      <h2>Passe o tempo na fila</h2>
      <p>
        Esperar não precisa ser chato. Selecionamos os melhores jogos para jogar enquanto você espera no mercado, no banco ou no parque de diversões. Transforme aqueles minutos perdidos em diversão instantânea.
      </p>
      <h3>Feitos para jogar em pé</h3>
      <ul>
        <li><strong>Uma mão:</strong> Jogue de boa com o dedão enquanto segura seu café ou sua bolsa.</li>
        <li><strong>Modo retrato:</strong> Otimizados para telas de celular na vertical, sem precisar girar o telefone.</li>
        <li><strong>Pausa instantânea:</strong> Pause o jogo a qualquer momento quando for sua vez, sem perder o progresso.</li>
      </ul>
    </div>
  </section>
</Layout>
