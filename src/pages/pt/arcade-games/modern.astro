---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { arcadeModernGames } from '~/data/games';

const metadata = {
  title: 'Jogos arcade modernos – Diversão da nova era',
  description: 'O espírito arcade em jogos modernos. Gráficos de alta qualidade e jogabilidade viciante.',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Jogos arcade modernos",
  "description": metadata.description,
  "url": "https://minigameshub.org/pt/arcade-games/modern",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": arcadeModernGames.map((game, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "VideoGame",
        "name": game.title,
        "url": `https://minigameshub.org/game/${game.slug}`,
        "image": game.thumbnail,
        "description": game.description,
        "genre": game.category,
        "playMode": "SinglePlayer",
        "applicationCategory": "Game"
      }
    }))
  }
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/pt/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Início
          </a>
        </li>
        <li class="inline-flex items-center">
          <a href="/pt/arcade-games" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            Jogos arcade
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Modernos</span>
          </div>
        </li>
      </ol>
    </nav>
    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 font-heading text-center">
      Jogos arcade modernos
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Espírito arcade com tecnologia moderna.
    </p>
    <GameGrid games={arcadeModernGames} />

    <div class="mt-16 prose dark:prose-invert max-w-none">
      <h2>A evolução do arcade</h2>
      <p>
        Os jogos arcade modernos combinam a jogabilidade viciante dos clássicos com os gráficos e a tecnologia de hoje. Mantendo o espírito dos high scores e da ação rápida, esses títulos aproveitam o hardware moderno para entregar experiências visualmente impressionantes.
      </p>
      <h3>Recursos modernos</h3>
      <p>
        Não é só uma carinha bonita; a jogabilidade evoluiu.
      </p>
      <ul>
        <li><strong>Gráficos HD:</strong> Visuais nítidos, efeitos de partículas e animações fluidas.</li>
        <li><strong>Novas mecânicas:</strong> Toques inovadores em gêneros clássicos que dão mais profundidade.</li>
        <li><strong>Multiplataforma:</strong> Feitos para funcionar perfeitamente no PC e no celular.</li>
      </ul>
    </div>
  </section>
</Layout>
