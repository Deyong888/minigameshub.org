---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import GamePlayer from '~/components/game/GamePlayer.astro';
import { getUniqueGames, getRelatedGames } from '~/data/games';
import type { Game } from '~/types/game';

export async function getStaticPaths() {
  const games = getUniqueGames();
  
  return games.map((game) => ({
    params: { id: game.id.toString(), slug: game.slug },
    props: { game, relatedGames: getRelatedGames(game, 12) },
  }));
}

export interface Props {
  game: Game;
  relatedGames: Game[];
}

const { game, relatedGames } = Astro.props;

// Generate personalized how-to-play instructions based on game details
const getHowToPlay = (title?: string, category?: string, description?: string) => {
  // GamePix 数据里部分游戏缺 category / description，需做空值兜底
  const lowerTitle = (title ?? '').toLowerCase();
  const lowerCategory = (category ?? '').toLowerCase();
  const lowerDesc = (description ?? '').toLowerCase();

  // Puzzle / Sudoku / Match games
  if (lowerCategory.includes('puzzle') || lowerCategory.includes('sudoku') || lowerCategory.includes('match') || lowerTitle.includes('puzzle') || lowerTitle.includes('sudoku')) {
    if (lowerDesc.includes('drag') || lowerDesc.includes('click')) {
      return 'Click and drag pieces to solve the puzzle. Think strategically and plan your moves ahead to beat your best score!';
    }
    return 'Use your mouse or touch to click and interact with the pieces. Plan your moves carefully to solve each level faster!';
  }

  // Shooting / Action / Arcade games
  if (lowerCategory.includes('shoot') || lowerCategory.includes('action') || lowerCategory.includes('arcade') || lowerTitle.includes('shooter') || lowerTitle.includes('gun')) {
    if (lowerDesc.includes('aim') || lowerDesc.includes('mouse')) {
      return 'Aim with your mouse and click to shoot. Use WASD or arrow keys to move. Dodge enemy attacks and survive as long as you can!';
    }
    return 'Use arrow keys or WASD to move, spacebar to jump, and mouse to aim or shoot. Collect power-ups and defeat enemies!';
  }

  // Racing / Sports / Driving
  if (lowerCategory.includes('racing') || lowerCategory.includes('sports') || lowerCategory.includes('driving') || lowerTitle.includes('race') || lowerTitle.includes('drive')) {
    if (lowerDesc.includes('bike') || lowerDesc.includes('motorcycle')) {
      return 'Use arrow keys to steer your motorcycle. Up to accelerate, down to brake. Balance carefully on ramps and avoid crashing!';
    }
    return 'Use arrow keys to control your vehicle. Up to accelerate, down to brake, left/right to steer. Collect power-ups and reach the finish line first!';
  }

  // Casual / Relax / Idle / Clicker
  if (lowerCategory.includes('casual') || lowerCategory.includes('relax') || lowerCategory.includes('idle') || lowerTitle.includes('clicker') || lowerTitle.includes('idle')) {
    return 'Simply click or tap to play. Sit back, relax, and enjoy at your own pace — no rush, no pressure!';
  }

  // Strategy / Tower Defense / Board
  if (lowerCategory.includes('strategy') || lowerCategory.includes('defense') || lowerCategory.includes('board') || lowerTitle.includes('tower') || lowerTitle.includes('defense')) {
    return 'Click or tap to place units and build your strategy. Manage resources wisely and defend your territory from waves of enemies!';
  }

  // Default: general instruction based on description hints
  if (lowerDesc.includes('keyboard') || lowerDesc.includes('arrow') || lowerDesc.includes('wasd')) {
    return 'Use your keyboard (arrow keys or WASD) to move, and spacebar or click to perform actions. Follow the on-screen instructions for specific controls.';
  }
  if (lowerDesc.includes('mouse') || lowerDesc.includes('click') || lowerDesc.includes('drag')) {
    return 'Use your mouse to click, drag, and interact with game elements. Most actions are intuitive — just start playing!';
  }

  return 'Use mouse, keyboard, or touch controls to play. The game is easy to pick up — just start and have fun!';
};

const howToPlayText = getHowToPlay(game.title, game.category, game.description);

// GamePix 部分游戏缺 category，统一兜底为 'Games'，避免 undefined.toLowerCase() 崩溃
const gameCategory = game.category ?? 'Games';
const categorySlug = gameCategory.toLowerCase().replace(/\s+/g, '-');

const metadata = {
  title: `${game.title} - Play Free Online | No Download | MiniGamesHub`,
  description: `Play ${game.title} free online. ${gameCategory} game, no download required, instant play in your browser. Enjoy this ${gameCategory} game on MiniGamesHub!`,
  openGraph: {
    type: 'video.other',
    images: [
        {
            url: game.thumbnail,
            width: 1200,
            height: 630,
            alt: `Play ${game.title} online`
        }
    ]
  },
};
---

<Layout metadata={metadata}>
  <!-- Game Player Section -->
  <WidgetWrapper id="game-player" containerClass="max-w-7xl mx-auto py-6" bg="<div class='absolute inset-0 bg-blue-50 dark:bg-transparent'></div>">
    
    <!-- Breadcrumbs (SVG) -->
    <nav class="flex mb-4" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Home
          </a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <a href={`/category/${categorySlug}`} class="ml-1 text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white md:ml-2">{gameCategory}</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">{game.title}</span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Game Area (2/3 width) -->
      <div class="lg:col-span-2">
        <GamePlayer game={game} />

        <!-- Game Controls / Info Bar -->
        <div class="flex items-center justify-between bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm mb-6 mt-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{game.title}</h1>
                <div class="text-sm text-gray-500">
                    <span class="mr-3">Plays: {game.plays?.toLocaleString()}</span>
                    <span>Rating: {game.rating}/5</span>
                </div>
            </div>
            <div class="flex gap-2">
                 <button id="favoriteBtn" data-slug={game.slug} class="btn-secondary px-3 py-1.5 text-sm rounded border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">🤍 Favorite</button>
                 <button id="shareBtn" class="btn-secondary px-3 py-1.5 text-sm rounded border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">🔗 Share</button>
            </div>
        </div>

        <!-- Game Description -->
        <div class="prose dark:prose-invert max-w-none bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
            {game.rich_content ? <div set:html={game.rich_content} /> : (
                <>
                    <h2>About {game.title}</h2>
                    <p>{game.description}</p>
                    <p>Play {game.title} online directly in your browser. No download required. This game is part of our {gameCategory} games collection and has been played {game.plays?.toLocaleString() || 'many'} times!</p>
                    
                    <h2>How to Play {game.title}</h2>
                    <p>{howToPlayText}</p>
                    
                    <h2>Why Play on MiniGamesHub?</h2>
                    <p>MiniGamesHub offers thousands of free online games with no downloads, no sign-ups, and instant play. Enjoy {game.title} and many more games across all categories!</p>
                </>
            )}
        </div>
      </div>

      <!-- Sidebar (1/3 width) -->
      <div class="lg:col-span-1">
        <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm sticky top-24">
            <h3 class="font-bold text-lg mb-4 border-b pb-2">Similar Games</h3>
            <div class="flex flex-col gap-4">
                {relatedGames.slice(0, 6).map(related => (
                    <a href={`/game/${related.id}-${related.slug}`} class="flex gap-3 group">
                        <img src={related.thumbnail} alt={related.title} class="w-20 h-14 object-cover rounded bg-gray-200" />
                        <div>
                            <h4 class="font-bold text-sm group-hover:text-primary line-clamp-2">{related.title}</h4>
                            <span class="text-xs text-gray-500">{related.category}</span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
      </div>

    </div>
  </WidgetWrapper>

  <!-- More Games Grid -->
  <GameGrid
    title="You Might Also Like"
    games={relatedGames}
    classes={{ container: 'py-8 lg:py-12' }}
  />

  <!-- Schema.org -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": game.title,
    "description": game.description ?? '',
    "genre": [gameCategory],
    "url": Astro.url.href,
    "image": game.thumbnail,
    "playMode": "SinglePlayer",
    "applicationCategory": "Browser Game",
    "operatingSystem": "Any",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": game.rating,
      "ratingCount": 100,
      "bestRating": "5",
      "worstRating": "1"
    }
  })} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://minigameshub.org/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": gameCategory,
        "item": `https://minigameshub.org/category/${categorySlug}`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": game.title
      }
    ]
  })} />

  <script>
    import { toggleFavorite, isFavorite, addToHistory } from '~/stores/gameState';
  
    const initGamePage = () => {
      const favoriteBtn = document.getElementById('favoriteBtn');
      const shareBtn = document.getElementById('shareBtn');
      
      // Favorite Logic
      if (favoriteBtn) {
          const slug = favoriteBtn.getAttribute('data-slug');
          
          const updateBtn = () => {
              if (!slug) return;
              const isFav = isFavorite(slug);
              favoriteBtn.textContent = isFav ? '❤️ Saved' : '🤍 Favorite';
              if (isFav) {
                  favoriteBtn.classList.add('text-pink-600', 'border-pink-200', 'bg-pink-50');
              } else {
                  favoriteBtn.classList.remove('text-pink-600', 'border-pink-200', 'bg-pink-50');
              }
          };
  
          favoriteBtn.onclick = () => {
              if (slug) {
                  toggleFavorite(slug);
                  updateBtn();
              }
          };
          
          updateBtn();

          // Add to history
          if (slug) {
             setTimeout(() => {
                 addToHistory(slug);
             }, 5000);
          }
      }
  
      // Share Logic
      if (shareBtn) {
          shareBtn.onclick = async () => {
              if (navigator.share) {
                  try {
                      await navigator.share({
                          title: document.title,
                          url: window.location.href
                      });
                  } catch (err) {
                      console.error('Share failed:', err);
                  }
              } else {
                  // Fallback to clipboard
                  try {
                      await navigator.clipboard.writeText(window.location.href);
                      const originalText = shareBtn.textContent;
                      shareBtn.textContent = '✅ Copied!';
                      setTimeout(() => {
                          shareBtn.textContent = originalText;
                      }, 2000);
                  } catch (err) {
                      console.error('Clipboard failed:', err);
                  }
              }
          };
      }
    };
  
    document.addEventListener('astro:page-load', initGamePage);
  </script>
</Layout>
