---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Get in Touch" />

  <ContactUs
    id="form"
    title="Send us a message!"
    subtitle="Have a question about our games or need help? We'd love to hear from you!"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email Address',
      },
    ]}
    textarea={{
      label: 'Your Message',
      placeholder: 'Tell us what you think or need help with...',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    button="Send Message"
    description="Our team typically responds within 24-48 hours."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="How can we help?"
    items={[
      {
        title: 'Game Issues',
        description: `Having trouble loading a game, experiencing crashes, or finding something not working right? Let us know and we'll investigate.`,
      },
      {
        title: 'Game Suggestions',
        description:
          'Know of a great game we should add? Or have ideas for new categories or features? Share your suggestions with us!',
      },
      {
        title: 'Feedback',
        description:
          'Love our site? Have ideas for improvement? We value all feedback - positive or constructive!',
      },
      {
        title: 'Partnerships',
        description:
          'Interested in partnering with us, advertising, or submitting your own game? We\'re always open to collaboration!',
      },
      {
        title: 'Email',
        description: 'contact@minigameshub.org',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
