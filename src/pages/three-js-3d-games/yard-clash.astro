---
import GamePage from '~/components/fable/GamePage.astro';
import { getThreeJsGame, getThreeJsRelated } from '~/data/threejs-games';

const game = getThreeJsGame('yard-clash')!;
const related = getThreeJsRelated(game, 3);
---

<GamePage
  slug="yard-clash"
  hubName="Three.js 3D Games"
  hubUrl="/three-js-3d-games"
  titleSuffix="Three.js 3D Browser Game"
  backLabel="Back to all Three.js 3D games"
  game={game}
  related={related}
/>
