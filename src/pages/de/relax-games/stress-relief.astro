---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { relaxStressReliefGames } from '~/data/games';

const metadata = {
  title: 'Stressabbau-Spiele – Platzen lassen, zerquetschen, entspannen',
  description: 'Baue Stress mit befriedigenden Spielen ab. Lass Blasen platzen, zerquetsche Objekte und lass die Anspannung los.',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Stressabbau-Spiele",
  "description": metadata.description,
  "url": "https://minigameshub.org/de/relax-games/stress-relief",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": relaxStressReliefGames.map((game, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "VideoGame",
        "name": game.title,
        "url": `https://minigameshub.org/game/${game.slug}`,
        "image": game.thumbnail,
        "description": game.description,
        "genre": game.category,
        "playMode": "SinglePlayer",
        "applicationCategory": "Game"
      }
    }))
  }
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/de/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Start
          </a>
        </li>
        <li class="inline-flex items-center">
          <a href="/de/relax-games" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            Entspannungsspiele
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Stressabbau</span>
          </div>
        </li>
      </ol>
    </nav>

    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 font-heading text-center">
      Stressabbau-Spiele
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Befriedigende Spiele, die Stress schmelzen lassen.
    </p>
    <GameGrid games={relaxStressReliefGames} />

    <div class="mt-16 prose dark:prose-invert max-w-none">
      <h2>Sofortiger Stressabbau</h2>
      <p>
        Manchmal brauchst du ein Ventil, um Dampf abzulassen. Unsere Stressabbau-Spiele bieten dir eine sichere, befriedigende Umgebung dafür. Von virtuellen Bläschen zerplatzen bis Sachen kaputtmachen – diese digitalen Interaktionen sorgen für sofortige Katharsis.
      </p>
      <h3>Warum diese Spiele funktionieren</h3>
      <ul>
        <li><strong>Befriedigendes Feedback:</strong> Sounds und Visuals, die deine Aktionen belohnen.</li>
        <li><strong>Volle Kontrolle:</strong> Du bestimmst Tempo und Intensität des Erlebnisses.</li>
        <li><strong>Mikro-Erfolge:</strong> Einfache Aufgaben, die ein Gefühl von Abschluss und Ordnung geben.</li>
      </ul>
    </div>
  </section>
</Layout>
