---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { noDownloadGames } from '~/data/games';

const metadata = {
  title: 'Instant-Spiele – Ohne Download, ohne Warten',
  description: 'Spring mit unseren Instant-Spielen direkt ins Geschehen. Ohne Download, ohne Installation – einfach klicken und spielen. Perfekt für schnelle Pausen.',
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Instant-Spiele",
  "description": metadata.description,
  "url": "https://minigameshub.org/de/no-download-games/instant-play",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": noDownloadGames.map((game, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "VideoGame",
        "name": game.title,
        "url": `https://minigameshub.org/de/game/${game.id}-${game.slug}`,
        "image": game.thumbnail,
        "description": game.description,
        "genre": game.category,
        "playMode": "SinglePlayer",
        "applicationCategory": "Game"
      }
    }))
  }
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/de/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white">
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
            </svg>
            Start
          </a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <a href="/de/no-download-games" class="ml-1 text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white md:ml-2">Spiele ohne Download</a>
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Instant-Spiel</span>
          </div>
        </li>
      </ol>
    </nav>

    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 font-heading text-center">
      Instant-Spiele
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Null Wartezeit. Maximaler Spaß. Klicken und sofort spielen.
    </p>

    <div class="prose dark:prose-invert max-w-none mb-12 bg-green-50 dark:bg-slate-800 p-6 rounded-lg">
      <h3>Was sind Instant-Spiele?</h3>
      <p>Instant-Spiele sind auf Tempo gebaut. Sie laden in Sekunden und brauchen weder Installation noch Speicherplatz. Ob du 5 Minuten oder eine Stunde hast – diese Spiele sind bereit, wenn du es bist.</p>
      <ul>
        <li><strong>Klick & Spiel:</strong> Keine Registrierung, keine Einrichtung nötig.</li>
        <li><strong>Spare Speicherplatz:</strong> Halte dein Gerät sauber und schnell.</li>
        <li><strong>Spiel überall:</strong> Greife von jedem Computer auf deine Lieblingsspiele zu.</li>
      </ul>
    </div>

    <GameGrid games={noDownloadGames} />

    <div class="mt-16 prose dark:prose-invert max-w-none">
      <h2>Das beste Instant-Spiel-Erlebnis</h2>
      <p>
        Zeit ist Geld – verschwende sie nicht mit Ladebalken. Unsere Instant-Spiele sind für sofortigen Spielspaß gemacht. Dank modernem Web-Streaming und effizientem Laden starten diese Spiele fast sofort, wenn du auf den Link klickst.
      </p>
      
      <h3>Perfekt für schnelle Pausen</h3>
      <p>
        Fünf Minuten vor dem Meeting? Wartest du aufs Rendern? Instant-Spiele füllen diese kleinen Lücken in deinem Tag perfekt mit etwas Lustigem und Fesselndem.
      </p>
      <ul>
        <li><strong>Niedrige Latenz:</strong> Optimiert für schnelle Reaktionszeiten.</li>
        <li><strong>Browser-Cache:</strong> Häufig gespielte Spiele laden sogar noch schneller.</li>
        <li><strong>Ohne Kompromisse:</strong> Spiel ein paar Minuten und schließe den Tab ohne schlechtes Gewissen.</li>
      </ul>
    </div>
  </section>
</Layout>
