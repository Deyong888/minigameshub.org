---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

import GameHero from '~/components/widgets/GameHero.astro';
import GameCard from '~/components/game/GameCard.astro';
import FAQs from '~/components/widgets/FAQs.astro';

import {
  // Mini Games
  miniArcadeGames,
  miniPuzzleGames,
  miniActionGames,
  // Small Games
  smallCasualGames,
  smallQuickGames,
  smallShortGames,
  // Relax Games
  relaxStressReliefGames,
  relaxCalmingGames,
  relaxCasualGames,
  // Bored Games
  officeGames,
  unblockedGames,
  waitingInLineGames,
  // Browser Games
  browserHtml5Games,
  // HTML5 Games
  html5MobileGames,
  // New Games
  newGames,
} from '~/data/games';

const metadata = {
  title: 'MiniGamesHub — Juega +3.900 Juegos Gratis | Juegos de Fútbol del Mundial en Línea',
  ignoreTitleTemplate: true,
  description:
    'Juega +3.900 juegos gratis en línea, incluyendo juegos de fútbol del Mundial, juegos de soccer, minijuegos, juegos arcade y más. Juego instantáneo en el navegador, ¡sin descargas!',
};

const sectionLinkClass =
  'inline-flex items-center gap-2 text-primary hover:text-primary/80 font-semibold text-sm transition-colors';
const sectionBg = {
  default: '',
  muted: 'bg-gray-50 dark:bg-slate-900/10',
  cool: 'bg-blue-50/50 dark:bg-slate-900/20',
  warm: 'bg-amber-50/50 dark:bg-slate-900/15',
  subtle: 'bg-violet-50/30 dark:bg-slate-900/10',
};
---

<Layout metadata={metadata}>
  <!-- HERO SECTION -->
  <div
    class="py-8 md:py-12 bg-gradient-to-b from-white via-blue-50/30 to-white dark:from-slate-950 dark:via-slate-900/50 dark:to-slate-950"
  >
    <div class="text-center mb-8 max-w-4xl mx-auto px-4">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-green-500 to-green-600 text-white text-sm font-medium mb-6 animate-fade-in shadow-md"
      >
        <Icon name="tabler:device-gamepad-2" class="w-4 h-4" />
        🔥 ¡Juegos de Fútbol del Mundial Ya Disponibles!
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter mb-4 font-heading animate-slide-up">
        Juega <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-purple-600">+3.900</span> Juegos Gratis
        al Instante
      </h1>
      <p
        class="text-lg md:text-xl text-gray-600 dark:text-slate-400 max-w-2xl mx-auto animate-slide-up animate-delay-100"
      >
        Clásicos arcade, puzzles para el cerebro, escapes relajantes: todo jugable en tu navegador. <span
          class="font-semibold text-gray-800 dark:text-gray-200">Sin descargas, sin registros, solo diversión.</span
        >
      </p>
    </div>
    <div class="animate-fade-in animate-delay-200">
      <GameHero />
    </div>
  </div>

  <!-- CATEGORY QUICK NAV -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-10">
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/es/mini-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-gradient-to-r from-primary to-purple-600 text-white text-sm font-medium hover:shadow-lg hover:shadow-primary/30 transition-all duration-300 hover:-translate-y-0.5"
      >
        <Icon name="tabler:device-gamepad-2" class="w-4 h-4 group-hover:scale-110 transition-transform" /> Minijuegos
      </a>
      <a
        href="/es/small-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-primary/30 hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
      >
        <Icon name="tabler:target-arrow" class="w-4 h-4 text-gray-500 group-hover:text-primary transition-colors" /> Juegos
        Pequeños
      </a>
      <a
        href="/es/relax-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-primary/30 hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
      >
        <Icon name="tabler:mood-heart" class="w-4 h-4 text-gray-500 group-hover:text-primary transition-colors" /> Juegos de
        Relax
      </a>
      <a
        href="/es/bored-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-primary/30 hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
      >
        <Icon name="tabler:dice-5" class="w-4 h-4 text-gray-500 group-hover:text-primary transition-colors" /> Juegos para
        Aburridos
      </a>
      <a
        href="/es/arcade-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-primary/30 hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
      >
        <Icon name="tabler:device-gamepad-2" class="w-4 h-4 text-gray-500 group-hover:text-primary transition-colors" />
        Arcade
      </a>
      <a
        href="/es/browser-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-primary/30 hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
      >
        <Icon name="tabler:browser" class="w-4 h-4 text-gray-500 group-hover:text-primary transition-colors" /> Navegador
      </a>
      <a
        href="/es/html5-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-primary/30 hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md"
      >
        <Icon name="tabler:code" class="w-4 h-4 text-gray-500 group-hover:text-primary transition-colors" /> HTML5
      </a>
      <a
        href="/new-games"
        class="group inline-flex items-center gap-2 px-5 py-3 rounded-full bg-gradient-to-r from-green-500 to-emerald-600 text-white text-sm font-semibold hover:shadow-lg hover:shadow-green-500/30 transition-all duration-300 hover:-translate-y-0.5"
      >
        <Icon name="tabler:sparkles" class="w-4 h-4 group-hover:scale-110 transition-transform" /> 🆕 Juegos Nuevos
      </a>
    </div>
  </section>

  <!-- NEW GAMES HIGHLIGHT BANNER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 mb-2">
    <div
      class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-green-600 via-emerald-600 to-teal-600 px-6 py-10 md:px-12 md:py-12 shadow-xl shadow-green-500/20"
    >
      <div
        class="absolute -top-16 -right-10 w-64 h-64 bg-white/10 rounded-full blur-2xl group-hover:scale-110 transition-transform"
      >
      </div>
      <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-xl">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 text-white text-xs font-semibold mb-3"
          >
            <Icon name="tabler:sparkles" class="w-4 h-4" /> Recién Añadido
          </div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-white font-heading">
            🆕 Nuevos Juegos Cada Semana
          </h2>
          <p class="mt-2 text-white/90 text-base md:text-lg">
            ¡Acabamos de ampliar a <strong>+3.900 juegos gratis</strong>, con los títulos más nuevos arriba! Sumérgete en
            los últimos lanzamientos, todos gratis y jugables al instante en tu navegador.
          </p>
        </div>
        <a
          href="/new-games"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-white text-green-700 font-bold text-base shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap"
        >
          Ver Juegos Nuevos <Icon name="tabler:arrow-right" class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- NEW GAMES GRID -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
    <div class="flex items-end justify-between mb-6">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center">
            <Icon name="tabler:sparkles" class="w-5 h-5 text-green-600" />
          </div>
          <span class="text-sm font-semibold tracking-wide text-green-600 uppercase">Recién Añadido</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter font-heading">
          <a href="/new-games" class="hover:text-green-600 transition-colors">Últimos Lanzamientos</a>
        </h2>
        <p class="mt-1 text-gray-600 dark:text-slate-400">Los juegos gratis más frescos, actualizados regularmente.</p>
      </div>
      <a href="/new-games" class={sectionLinkClass}>
        Ver Todos los Nuevos <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
      {newGames.slice(0, 12).map((game) => <GameCard game={game} />)}
    </div>
  </section>

  <!-- 1. Mini Games -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
            <Icon name="tabler:device-gamepad-2" class="w-5 h-5 text-primary" />
          </div>
          <span class="text-sm font-semibold tracking-wide text-primary uppercase">Minijuegos</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter font-heading">
          <a href="/es/mini-games" class="hover:text-primary transition-colors">Diversión Rápida en Cualquier Momento</a>
        </h2>
        <p class="mt-1 text-gray-600 dark:text-slate-400">
          Juegos cortos y adictivos, perfectos para descansos y sesiones rápidas.
        </p>
      </div>
      <a href="/es/mini-games" class={sectionLinkClass}>
        Ver Todos <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>

    <div class="space-y-10">
      <div>
        <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
          <Icon name="tabler:stars" class="w-4 h-4 text-primary" /> Arcade
        </h3>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Diversión arcade clásica en formato mini.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
          {miniArcadeGames.slice(0, 6).map((game) => <GameCard game={game} />)}
        </div>
      </div>
      <div>
        <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
          <Icon name="tabler:puzzle" class="w-4 h-4 text-primary" /> Puzzle
        </h3>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Desafíos mentales para mantener tu mente aguda.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
          {miniPuzzleGames.slice(0, 6).map((game) => <GameCard game={game} />)}
        </div>
      </div>
      <div>
        <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
          <Icon name="tabler:flame" class="w-4 h-4 text-primary" /> Acción
        </h3>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Emoción de ritmo rápido para buscadores de adrenalina.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
          {miniActionGames.slice(0, 6).map((game) => <GameCard game={game} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <hr class="border-gray-200 dark:border-gray-800" />
  </div>

  <!-- 2. Small Games -->
  <section class={[sectionBg.muted, 'py-10 lg:py-14'].join(' ')}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
              <Icon name="tabler:target-arrow" class="w-5 h-5 text-primary" />
            </div>
            <span class="text-sm font-semibold tracking-wide text-primary uppercase">Juegos Pequeños</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter font-heading">
            <a href="/es/small-games" class="hover:text-primary transition-colors">Diversión Grande en Paquetes Pequeños</a>
          </h2>
          <p class="mt-1 text-gray-600 dark:text-slate-400">Juegos HTML5 ligeros que funcionan sin problemas en cualquier dispositivo.</p>
        </div>
        <a href="/es/small-games" class={sectionLinkClass}>
          Ver Todos <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <div class="space-y-10">
        <div>
          <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
            <Icon name="tabler:mood-smile" class="w-4 h-4 text-primary" /> Casual
          </h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Juegos pequeños relajantes para desconectar.</p>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
            {smallCasualGames.slice(0, 6).map((game) => <GameCard game={game} />)}
          </div>
        </div>
        <div>
          <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
            <Icon name="tabler:bolt" class="w-4 h-4 text-primary" /> Rápido
          </h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Juegos de menos de 5 minutos para agendas ocupadas.</p>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
            {smallQuickGames.slice(0, 6).map((game) => <GameCard game={game} />)}
          </div>
        </div>
        <div>
          <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
            <Icon name="tabler:clock" class="w-4 h-4 text-primary" /> Corto
          </h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Gratificación instantánea en cada sesión.</p>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
            {smallShortGames.slice(0, 6).map((game) => <GameCard game={game} />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Relax Games -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
              <Icon name="tabler:mood-heart" class="w-5 h-5 text-primary" />
            </div>
            <span class="text-sm font-semibold tracking-wide text-primary uppercase">Juegos de Relax</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter font-heading">
            <a href="/es/relax-games" class="hover:text-primary transition-colors">Relájate y Desestrésate</a>
          </h2>
          <p class="mt-1 text-gray-600 dark:text-slate-400">Juegos calmados y terapéuticos para derretir tu estrés.</p>
        </div>
        <a href="/es/relax-games" class={sectionLinkClass}>
          Ver Todos <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
            <Icon name="tabler:wind" class="w-4 h-4 text-primary" /> Calmantes
          </h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Juegos relajantes para reducir la ansiedad.</p>
          <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
            {relaxCalmingGames.slice(0, 2).map((game) => <GameCard game={game} />)}
          </div>
        </div>
        <div>
          <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
            <Icon name="tabler:heart" class="w-4 h-4 text-primary" /> Alivio del Estrés
          </h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Juegos diseñados para derretir las preocupaciones.</p>
          <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
            {relaxStressReliefGames.slice(0, 2).map((game) => <GameCard game={game} />)}
          </div>
        </div>
        <div>
          <h3 class="text-lg font-bold mb-1 flex items-center gap-2">
            <Icon name="tabler:coffee" class="w-4 h-4 text-primary" /> Casual
          </h3>
          <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Juegos de baja presión para sesiones pacíficas.</p>
          <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
            {relaxCasualGames.slice(0, 2).map((game) => <GameCard game={game} />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <hr class="border-gray-200 dark:border-gray-800" />
  </div>

  <!-- 4. Bored Games (Scenario) -->
  <section class={[sectionBg.muted, 'py-10 lg:py-14'].join(' ')}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
              <Icon name="tabler:dice-5" class="w-5 h-5 text-primary" />
            </div>
            <span class="text-sm font-semibold tracking-wide text-primary uppercase">Juegos para Aburridos</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter font-heading">
            <a href="/es/bored-games" class="hover:text-primary transition-colors">Vence el Aburrimiento en Cualquier Momento</a>
          </h2>
          <p class="mt-1 text-gray-600 dark:text-slate-400">
            Colecciones curadas para cada situación: trabajo, escuela o casa.
          </p>
        </div>
        <a href="/es/bored-games" class={sectionLinkClass}>
          Ver Todos <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-slate-900/50">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-10 h-10 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
              <Icon name="tabler:briefcase" class="w-5 h-5 text-amber-600 dark:text-amber-400" />
            </div>
            <div>
              <h3 class="font-bold">Aburrido en el Trabajo</h3>
              <p class="text-xs text-gray-500">Tecla de jefe incluida</p>
            </div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
            {officeGames.slice(0, 2).map((game) => <GameCard game={game} />)}
          </div>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-slate-900/50">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
              <Icon name="tabler:backpack" class="w-5 h-5 text-green-600 dark:text-green-400" />
            </div>
            <div>
              <h3 class="font-bold">Aburrido en la Escuela</h3>
              <p class="text-xs text-gray-500">Desbloqueado y listo para Chromebook</p>
            </div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
            {unblockedGames.slice(0, 2).map((game) => <GameCard game={game} />)}
          </div>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-slate-900/50">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
              <Icon name="tabler:clock-hour-4" class="w-5 h-5 text-blue-600 dark:text-blue-400" />
            </div>
            <div>
              <h3 class="font-bold">Esperando en Fila</h3>
              <p class="text-xs text-gray-500">Diversión rápida y para móviles</p>
            </div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
            {waitingInLineGames.slice(0, 2).map((game) => <GameCard game={game} />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MORE CATEGORIES: compact grid showcase -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter font-heading">Explora Más Categorías</h2>
