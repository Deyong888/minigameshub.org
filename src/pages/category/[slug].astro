---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import FaqSection from '~/components/common/FaqSection.astro';
import { getUniqueCategories, getGamesByCategory } from '~/data/games';
import { getCategoryFaq } from '~/utils/gameContent';

export async function getStaticPaths() {
  const categories = getUniqueCategories();
  
  return categories.map((category) => ({
    params: { slug: category.toLowerCase().replace(/\s+/g, '-') },
    props: { category, games: getGamesByCategory(category) },
  }));
}

const { category, games } = Astro.props;
const otherCategories = getUniqueCategories().filter((c) => c !== category).sort();
const faq = getCategoryFaq(category);

const title = `Best ${category} Games - Play Free Online (No Download)`;
const description = `Play the best free ${category} games instantly in your browser on MiniGamesHub.org. No download, no sign-up — hundreds of ${category} games ready to play on PC, Chromebook, and mobile.`;

const metadata = {
  title: title,
  description: description,
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://minigameshub.org/"
    },{
      "@type": "ListItem",
      "position": 2,
      "name": "All Categories",
      "item": "https://minigameshub.org/mini-games" 
    },{
      "@type": "ListItem",
      "position": 3,
      "name": category,
      "item": Astro.url.href
    }]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "description": description,
    "url": Astro.url.href,
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": games.slice(0, 20).map((game, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `https://minigameshub.org/game/${game.id}-${game.slug}`,
        "name": game.title
      }))
    }
  }
];
---

<Layout metadata={metadata}>
  {jsonLd.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <div class="text-center mb-12">
      <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 capitalize">
        {category} Games
      </h1>
      <p class="text-xl text-muted">
        Play the best free online <strong>{category} games</strong> — browser-based, no download, instant fun.
        <br/>
        Every title below embeds the real playable game with its official cover, so you can start playing in one click.
      </p>
    </div>
    
    <div class="mb-8">
        <a href="/mini-games" class="text-primary hover:underline">← Back to All Games</a>
    </div>

    <GameGrid games={games} />

    <FaqSection items={faq} heading="Frequently Asked Questions" />

    <div class="mt-16">
      <h2 class="text-2xl font-bold mb-4">More Game Categories</h2>
      <div class="flex flex-wrap gap-2">
        {otherCategories.map((c) => (
          <a
            href={`/category/${c.toLowerCase().replace(/\s+/g, '-')}`}
            class="px-3 py-1.5 rounded-full bg-gray-100 dark:bg-slate-800 text-sm hover:bg-primary hover:text-white transition-colors"
          >{c}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>
