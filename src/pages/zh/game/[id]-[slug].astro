---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import GamePlayer from '~/components/game/GamePlayer.astro';
import FaqSection from '~/components/common/FaqSection.astro';
import { getUniqueGames, getRelatedGames } from '~/data/games';
import { getLangFromUrl, useTranslations, translateDynamic } from '~/utils/i18n';
import { getHowToPlayZh, getTipsZh, getGameDetailsZh, getGameFaqZh } from '~/utils/gameContent';
import type { Game } from '~/types/game';

// Hybrid rendering: game pages render on-demand on Vercel (cached at edge).
// See src/pages/game/[id]-[slug].astro for rationale.
export const prerender = false;

const gameLookup = new Map(getUniqueGames().map((g) => [`${g.id}-${g.slug}`, g]));
const game = gameLookup.get(`${Astro.params.id}-${Astro.params.slug}`);
if (!game) {
  return new Response(
    '<!doctype html><html lang="zh"><head><meta charset="utf-8">' +
      '<title>未找到游戏 | MiniGamesHub</title><meta name="robots" content="noindex"></head>' +
      '<body style="font-family:sans-serif;text-align:center;padding:80px">' +
      '<h1>未找到游戏</h1><p>您查找的游戏已不再提供。</p>' +
      '<p><a href="/zh/">返回 MiniGamesHub</a></p></body></html>',
    { status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } }
  );
}
const relatedGames = getRelatedGames(game, 12);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getTranslatedCategory = (cat: string) => {
  const key = `cat.${cat.toLowerCase()}`;
  const translated = translateDynamic(t, key);
  return translated || cat.charAt(0).toUpperCase() + cat.slice(1);
};

const translatedCategory = getTranslatedCategory(game.category);
const categorySlug = game.category.toLowerCase().replace(/\s+/g, '-');

// Enriched, category-aware body content (P0 SEO fix) — generated in src/utils/gameContent.ts
const howToPlayZh = getHowToPlayZh(game);
const tipsZh = getTipsZh(game);
const detailsZh = getGameDetailsZh(game);
const faqZh = getGameFaqZh(game);

const metadata = {
  title: `玩 ${game.title} - 免费在线游戏 | MiniGamesHub.org`,
  description: `在 MiniGamesHub.org 免费在线玩 ${game.title}。无需下载。${game.description}`,
  openGraph: {
    type: 'video.other',
    images: [
      {
        url: game.thumbnail,
        width: 1200,
        height: 630,
        alt: game.title,
      },
    ],
  },
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.title,
  description: game.description,
  image: game.thumbnail,
  url: `https://minigameshub.org/zh/game/${game.id}-${game.slug}`,
  genre: game.category,
  playMode: 'SinglePlayer',
  applicationCategory: 'Game',
  inLanguage: 'zh',
};

const playerLabels = {
  loading: '正在加载',
  bossKey: '老板键',
  mute: '静音',
  unmute: '开启声音',
  fullscreen: '全屏模式',
  bossKeyHint: '按 ESC 键开启老板键模式',
  returnToGame: '按 ESC 键返回游戏...',
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <!-- Game Player Section -->
  <WidgetWrapper
    id="game-player"
    containerClass="max-w-7xl mx-auto py-6"
    bg="<div class='absolute inset-0 bg-blue-50 dark:bg-transparent'></div>"
  >
    <!-- Breadcrumbs (SVG) -->
    <nav class="flex mb-4" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a
            href="/zh/"
            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white"
          >
            <svg
              class="w-3 h-3 mr-2.5"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"
              ></path>
            </svg>
            {t('nav.home')}
          </a>
        </li>
        <li>
          <div class="flex items-center">
            <svg
              class="w-3 h-3 text-gray-400 mx-1"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 6 10"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m1 9 4-4-4-4"></path>
            </svg>
            <a
              href={`/zh/category/${game.category.toLowerCase().replace(/\s+/g, '-')}`}
              class="ml-1 text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white md:ml-2"
              >{translatedCategory}</a
            >
          </div>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg
              class="w-3 h-3 text-gray-400 mx-1"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 6 10"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m1 9 4-4-4-4"></path>
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">{game.title}</span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Game Area (2/3 width) -->
      <div class="lg:col-span-2">
        <GamePlayer game={game} labels={playerLabels} />

        <!-- Game Controls / Info Bar -->
        <div class="flex items-center justify-between bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm mb-6 mt-4">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{game.title}</h1>
            <div class="text-sm text-gray-500">
              <span class="mr-3">{t('game.plays')}: {game.plays?.toLocaleString()}</span>
              <span>{t('game.rating')}: {game.rating}/5</span>
            </div>
          </div>
          <div class="flex gap-2">
            <button
              id="favoriteBtn"
              data-slug={game.slug}
              data-text-favorite={t('game.favorite')}
              data-text-favorited="已收藏"
              class="btn-secondary px-3 py-1.5 text-sm rounded border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
              >🤍 {t('game.favorite')}</button
            >
            <button
              id="shareBtn"
              class="btn-secondary px-3 py-1.5 text-sm rounded border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700"
              >🔗 {t('game.share')}</button
            >
          </div>
        </div>

        <!-- Game Description -->
        <div class="prose dark:prose-invert max-w-none bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
          <h3>{t('game.about')} {game.title}</h3>
          <p>{game.description}</p>
          <p>{t('game.description', [game.title, translatedCategory])}</p>

          <h3>{t('game.howToPlay')}</h3>
          <p>{howToPlayZh}</p>

          <h3>游戏技巧</h3>
          <ul class="list-disc pl-6 space-y-1">
            {tipsZh.map((tip) => <li>{tip}</li>)}
          </ul>

          <h3>游戏详情</h3>
          <table class="w-full text-sm border-collapse">
            <tbody>
              {detailsZh.map((row) => (
                <tr class="border-b border-gray-200 dark:border-gray-700">
                  <th class="text-left py-2 pr-4 font-semibold align-top">{row.label}</th>
                  <td class="py-2 align-top">{row.value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <h3>更多类似游戏</h3>
          <p>
            喜欢 {game.title}？查看我们的{' '}
            <a href={`/zh/category/${categorySlug}`} class="text-primary hover:underline">{translatedCategory} 游戏</a>{' '}
            合集，发现更多免费即玩的精选游戏。
          </p>
        </div>

        <!-- FAQ（P1 SEO：FAQPage JSON-LD + 点击展开） -->
        <FaqSection items={faqZh} heading="常见问题" />
      </div>

      <!-- Sidebar (1/3 width) -->
      <div class="lg:col-span-1">
        <div class="bg-white dark:bg-slate-800 p-4 rounded-lg shadow-sm sticky top-24">
          <h3 class="font-bold text-lg mb-4 border-b pb-2">{t('game.similar')}</h3>
          <div class="flex flex-col gap-4">
            {
              relatedGames.slice(0, 6).map((related) => (
                <a href={`/zh/game/${related.id}-${related.slug}`} class="flex gap-3 group">
                  <img src={related.thumbnail} alt={related.title} class="w-20 h-14 object-cover rounded bg-gray-200" />
                  <div>
                    <div class="font-bold text-sm group-hover:text-primary transition">{related.title}</div>
                    <div class="text-xs text-gray-500">
                      {getTranslatedCategory(related.category)} • ⭐ {related.rating}
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- More Games Grid -->
  <GameGrid title={t('game.youMightLike')} games={relatedGames} classes={{ container: 'py-8 lg:py-12' }} />

  <!-- Schema.org -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'VideoGame',
      name: game.title,
      description: game.description,
      genre: [game.category],
      url: Astro.url.href,
      image: game.thumbnail,
      playMode: 'SinglePlayer',
      applicationCategory: 'Browser Game',
      operatingSystem: 'Any',
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: game.rating,
        ratingCount: 100,
        bestRating: '5',
        worstRating: '1',
      },
      inLanguage: 'zh',
    })}
  />

  <script>
    import { toggleFavorite, isFavorite, addToHistory } from '~/stores/gameState';

    const initGamePage = () => {
      const favoriteBtn = document.getElementById('favoriteBtn');
      const shareBtn = document.getElementById('shareBtn');

      // Favorite Logic
      if (favoriteBtn) {
        const slug = favoriteBtn.getAttribute('data-slug');
        const favoriteText = favoriteBtn.getAttribute('data-text-favorite') || 'Favorite';
        const favoritedText = favoriteBtn.getAttribute('data-text-favorited') || 'Saved';

        const updateBtn = () => {
          if (!slug) return;
          const isFav = isFavorite(slug);
          favoriteBtn.textContent = isFav ? `❤️ ${favoritedText}` : `🤍 ${favoriteText}`;
          if (isFav) {
            favoriteBtn.classList.add('text-pink-600', 'border-pink-200', 'bg-pink-50');
          } else {
            favoriteBtn.classList.remove('text-pink-600', 'border-pink-200', 'bg-pink-50');
          }
        };

        favoriteBtn.onclick = () => {
          if (slug) {
            toggleFavorite(slug);
            updateBtn();
          }
        };
        updateBtn();
      }

      // Share Logic
      if (shareBtn) {
        shareBtn.onclick = () => {
          if (navigator.share) {
            navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } else {
            navigator.clipboard.writeText(window.location.href);
            alert('Link copied to clipboard!');
          }
        };
      }

      // Add to History
      const slug = favoriteBtn?.getAttribute('data-slug');
      if (slug) {
        addToHistory(slug);
      }
    };

    // Run on initial load and view transitions
    initGamePage();
    document.addEventListener('astro:after-swap', initGamePage);
  </script>
</Layout>
