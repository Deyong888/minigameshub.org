---
import Layout from '~/layouts/PageLayout.astro';
import GameGrid from '~/components/widgets/GameGrid.astro';
import { newGames } from '~/data/games';

const PAGE_SIZE = 96;
const games = newGames.slice(0, PAGE_SIZE);
const totalNew = newGames.length;

const metadata = {
  title: 'New Games - Freshly Added Free Online Games',
  description:
    'The newest free online games added to MiniGamesHub. Play the latest HTML5 and browser games instantly — no download required.',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'New Games',
  description: metadata.description,
  url: 'https://minigameshub.org/new-games',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: games.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'VideoGame',
        name: game.title,
        url: `https://minigameshub.org/game/${game.slug}`,
        image: game.thumbnail,
        description: game.description,
        genre: game.category,
        playMode: 'SinglePlayer',
        applicationCategory: 'Game',
      },
    })),
  },
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a
            href="/"
            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white"
          >
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z" />
            </svg>
            Home
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">New Games</span>
          </div>
        </li>
      </ol>
    </nav>

    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 text-center">
      New Games
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Freshly added free online games — updated with the latest releases from our catalog.
    </p>

    <div class="prose prose-lg dark:prose-invert max-w-none mb-12 text-gray-700 dark:text-gray-300">
      <p>
        Every game below was recently published and is ready to play right in your browser. No downloads, no installs —
        just click and play. New titles are pulled from the GamePix catalog and added to MiniGamesHub as they go live,
        so this page keeps growing with the freshest HTML5 and casual games on the web.
      </p>
      <p>
        Looking for something specific? Browse our <a href="/mini-games" class="text-primary hover:underline">Mini Games</a>,
        <a href="/arcade-games" class="text-primary hover:underline">Arcade Games</a>, or
        <a href="/relax-games" class="text-primary hover:underline">Relax Games</a> collections — or use the search bar to jump straight to a title.
      </p>
    </div>

    <p class="text-center text-sm text-gray-500 dark:text-gray-400 mb-8">
      Showing the {games.length} newest of {totalNew} recently added games.
    </p>

    <GameGrid
      title="Latest Arrivals"
      subtitle="The most recently published games on MiniGamesHub"
      games={games}
    />
  </section>
</Layout>
