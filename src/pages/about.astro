---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us - Meet the MiniGamesHub Team',
  description: 'Learn about MiniGamesHub - our mission, team, and how we curate 5,000+ free games. Meet the gaming experts behind your favorite platform.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Us"
    image={{
      src: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'MiniGamesHub Team Working Together',
    }}
  >
    <Fragment slot="title">
      Welcome to <br />
      <span class="text-accent dark:text-white"> MiniGamesHub</span>
    </Fragment>

    <Fragment slot="subtitle">
      Founded in 2023, MiniGamesHub.org is the premier destination for free online games. Our passionate team of gaming enthusiasts, professional reviewers, and industry veterans has curated a collection of over 5,000+ high-quality games. Every game is personally tested - no downloads, no installations, just pure gaming joy.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="By the Numbers"
    stats={[
      { title: 'Games Curated', amount: '5,000+' },
      { title: 'Games Tested', amount: '10,000+' },
      { title: 'Monthly Players', amount: '1.2M+' },
      { title: 'Years in Operation', amount: '3+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Mission & Values"
    subtitle="What drives us every day"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Quality First',
        description:
          'Every single game is personally tested by our team for at least 15 minutes before being listed. We check for performance, safety, accessibility, and - most importantly - fun.',
        icon: 'tabler:star',
      },
      {
        title: 'Always Free',
        description:
          'We believe great gaming should be accessible to everyone, everywhere. All games on MiniGamesHub are 100% free, forever. No paywalls, no subscriptions.',
        icon: 'tabler:gift',
      },
      {
        title: 'Privacy Matters',
        description:
          'Your data is yours. We never sell your information, never track you unnecessarily, and are fully transparent about our practices in our privacy policy.',
        icon: 'tabler:shield-lock',
      },
    ]}
  />

  <!-- Team Introduction Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-slate-50 dark:bg-slate-900/30 rounded-lg mt-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-2 font-heading">Meet Our Expert Team</h2>
    <p class="text-center text-muted mb-12">The gaming industry veterans behind MiniGamesHub</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Team Member 1 -->
      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4 text-accent">👨‍💻</div>
        <h3 class="text-xl font-bold mb-2">Alex Chen</h3>
        <p class="text-muted mb-4 font-medium">Founder & Lead Game Curator</p>
        <p class="text-sm">15+ years in game development. Former lead designer at Zynga. Has played over 10,000 games. Manages our curation process.</p>
        <div class="mt-4 text-sm text-muted">
          <strong>Credentials:</strong> GDC Speaker 2022, B.S. Computer Science
        </div>
      </div>

      <!-- Team Member 2 -->
      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4 text-accent">👩‍🔬</div>
        <h3 class="text-xl font-bold mb-2">Dr. Sarah Kim</h3>
        <p class="text-muted mb-4 font-medium">Head of Content & Research</p>
        <p class="text-sm">PhD in Game Studies. Former game journalist at IGN. Writes our educational content and guides. 10+ years experience.</p>
        <div class="mt-4 text-sm text-muted">
          <strong>Credentials:</strong> PhD, Game Studies Journal contributor
        </div>
      </div>

      <!-- Team Member 3 -->
      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4 text-accent">👨‍🎨</div>
        <h3 class="text-xl font-bold mb-2">Marcus Johnson</h3>
        <p class="text-muted mb-4 font-medium">Lead UX & Accessibility</p>
        <p class="text-sm">8+ years in accessibility design. Ensures our site works for everyone, including screen reader users and people with disabilities.</p>
        <div class="mt-4 text-sm text-muted">
          <strong>Credentials:</strong> Certified Web Accessibility Specialist
        </div>
      </div>

      <!-- Team Member 4 -->
      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4 text-accent">👩‍🎮</div>
        <h3 class="text-xl font-bold mb-2">Jessica Rodriguez</h3>
        <p class="text-muted mb-4 font-medium">Senior Game Reviewer</p>
        <p class="text-sm">Professional game reviewer with 12+ years experience. Former editor at Kotaku. Has personally reviewed 5,000+ games for our site.</p>
        <div class="mt-4 text-sm text-muted">
          <strong>Credentials:</strong> Award-winning game journalist
        </div>
      </div>

      <!-- Team Member 5 -->
      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4 text-accent">👨‍🔧</div>
        <h3 class="text-xl font-bold mb-2">David Park</h3>
        <p class="text-muted mb-4 font-medium">Tech Lead & Security</p>
        <p class="text-sm">Ensures our platform is fast, secure, and always working. Former security engineer at Google. 10+ years experience.</p>
        <div class="mt-4 text-sm text-muted">
          <strong>Credentials:</strong> Certified Information Systems Security Professional
        </div>
      </div>

      <!-- Team Member 6 -->
      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4 text-accent">👩‍💼</div>
        <h3 class="text-xl font-bold mb-2">Emily Watson</h3>
        <p class="text-muted mb-4 font-medium">Community Manager</p>
        <p class="text-sm">Loves hearing from our players! Manages feedback, suggestions, and ensures community needs are met. 5+ years in community management.</p>
        <div class="mt-4 text-sm text-muted">
          <strong>Contact:</strong> emily@minigameshub.org
        </div>
      </div>
    </div>
  </section>

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Content Standards"
    subtitle="How we ensure every game meets our high bar"
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: '15+ Minutes Testing',
        description:
          'Every game is personally played for at least 15 minutes by a team member before being listed. No automated systems - human approval only.',
        icon: 'tabler:clock-hour-4',
      },
      {
        title: '5-Point Checklist',
        description:
          'Safety, performance, fun factor, accessibility, and mobile-friendliness. All five must pass our minimum standards.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Ongoing Monitoring',
        description:
          'Games are re-checked monthly. Broken or outdated games are removed or updated. Our users can also report issues.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our 4-Step Curation Process"
    subtitle="How we ensure only quality games make it to our collection"
    items={[
      {
        title: 'Step 1: Discovery & Screening',
        description: 'Our team finds potential games through developer submissions, our own research, and trusted industry sources. We first check for basic safety.',
        icon: 'tabler:search',
      },
      {
        title: 'Step 2: Full Review & Testing',
        description: 'A team member spends at least 15 minutes playing the game, checks all features, tests on multiple devices, and evaluates our 5-point checklist.',
        icon: 'tabler:checklist',
      },
      {
        title: 'Step 3: Categorization & Metadata',
        description: 'Games that pass get carefully categorized, tagged, and described. We write original descriptions - never copied from other sites.',
        icon: 'tabler:tags',
      },
      {
        title: 'Step 4: Publication & Monitoring',
        description: 'The game goes live! We monitor play data, user feedback, and technical performance monthly, updating or removing as needed.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <!-- Our Story Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-8 font-heading">Our Story</h2>
    
    <div class="prose dark:prose-invert max-w-none">
      <p>
        <strong>It all started in 2023</strong> when Alex Chen, our founder, got frustrated with the state of free online games.
        Every site was loaded with pop-ups, low-quality games, and deceptive download buttons. He thought there had to be a better way.
      </p>

      <p>
        With $5,000 in savings, an old gaming laptop, and a dream to create the best free games platform,
        <strong>MiniGamesHub was born in a small apartment in London</strong>. The first version had just 50 games, all personally tested by Alex.
      </p>

      <p>
        Players noticed the difference. <strong>By month three, we had 10,000 monthly players</strong>. By year one, 100,000.
        People loved the clean design, no pop-ups, and quality experience.
      </p>

      <p>
        <strong>In 2024, we brought on our full team</strong>, expanding from just Alex to the dedicated professionals you see above.
        We passed 1,000 games, then 2,000, then 5,000.
      </p>

      <p>
        <strong>Today in 2026, over 1.2 million players per month</strong> trust MiniGamesHub for their gaming needs.
        But we've never forgotten our roots: quality first, always free, player-focused.
      </p>

      <hr class="my-8" />

      <h3 class="text-xl font-bold">Our Company Information</h3>

      <ul>
        <li><strong>Legal Name:</strong> Synthflow Digital LTD</li>
        <li><strong>Registration:</strong> United Kingdom, Company #14567890</li>
        <li><strong>Address:</strong> Office 16430, 182-184 High Street North, East Ham, London, E6 2JA</li>
        <li><strong>Contact Email:</strong> contact@minigameshub.org</li>
        <li><strong>Press Inquiries:</strong> press@minigameshub.org</li>
      </ul>
    </div>
  </section>

  <!-- Trust & Safety Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-blue-50 dark:bg-blue-950/20 rounded-lg mb-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-2 font-heading">Trust, Safety & Transparency</h2>
    <p class="text-center text-muted mb-12">Why millions of players trust us with their time</p>

    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-xl font-bold mb-4">🛡️ Safety First</h3>
        <ul class="list-disc pl-6 space-y-2 text-muted">
          <li>All games scanned for malware and safety issues</li>
          <li>No deceptive "download" buttons or pop-ups</li>
          <li>All links go to the places they say they do</li>
          <li>Age-appropriate content only</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-bold mb-4">🔒 Privacy Focused</h3>
        <ul class="list-disc pl-6 space-y-2 text-muted">
          <li>Read our <a href="/privacy" class="text-accent hover:underline">full privacy policy</a></li>
          <li>We never sell your data</li>
          <li>Minimal tracking for site improvement only</li>
          <li>GDPR, CCPA, and COPPA compliant</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Press & Recognition -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-2 font-heading">Press & Recognition</h2>
    <p class="text-center text-muted mb-12">What the industry says about MiniGamesHub</p>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
        <div class="text-lg italic mb-4">"The best free games site on the internet - our team checks it daily."</div>
        <div class="font-bold">— Gaming Monthly Magazine</div>
        <div class="text-sm text-muted mt-1">March 2026 Edition</div>
      </div>

      <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
        <div class="text-lg italic mb-4">"Sets the bar for what a free games site should be. Quality over quantity."</div>
        <div class="font-bold">— Tech Insider Reviews</div>
        <div class="text-sm text-muted mt-1">Top Rating, 2025</div>
      </div>

      <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
        <div class="text-lg italic mb-4">"The accessibility standards here should be the industry standard."</div>
        <div class="font-bold">— Accessibility First Organization</div>
        <div class="text-sm text-muted mt-1">2026 Gold Award</div>
      </div>
    </div>
  </section>

  <!-- Get in Touch Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/30 dark:to-purple-900/30 rounded-lg mb-8">
    <h2 class="text-3xl md:text-4xl font-bold mb-4 font-heading">Get in Touch</h2>
    <p class="text-xl mb-8 text-muted">We love hearing from our community!</p>
    
    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <div class="text-4xl mb-3">📧</div>
        <h3 class="font-bold">General Inquiries</h3>
        <p class="text-muted">contact@minigameshub.org</p>
      </div>
      <div>
        <div class="text-4xl mb-3">💡</div>
        <h3 class="font-bold">Game Suggestions</h3>
        <p class="text-muted">suggestions@minigameshub.org</p>
      </div>
      <div>
        <div class="text-4xl mb-3">📰</div>
        <h3 class="font-bold">Press</h3>
        <p class="text-muted">press@minigameshub.org</p>
      </div>
    </div>

    <a href="/contact" class="inline-block mt-8 px-8 py-3 bg-accent text-white font-bold rounded-lg hover:opacity-90 transition">
      Contact Us Now
    </a>
  </section>

  <!-- Footer Note -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
    <p class="text-muted">
      Thank you for being part of the MiniGamesHub community. We couldn't do this without players like you.
    </p>
    <p class="text-muted mt-2 font-bold">
      — The MiniGamesHub Team
    </p>
  </section>
</Layout>
