---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us - MiniGamesHub | Free Online Games Platform',
  description: 'Learn about MiniGamesHub — an AI-powered free online games platform by Synthflow Digital LTD. 1,400+ browser games, no downloads, instant play.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Us"
    image={{
      src: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'MiniGamesHub Team Working Together',
    }}
  >
    <Fragment slot="title">
      Welcome to <br />
      <span class="text-accent dark:text-white"> MiniGamesHub</span>
    </Fragment>

    <Fragment slot="subtitle">
      MiniGamesHub is a free online games platform operated by Synthflow Digital LTD — an AI-native company building the next generation of digital entertainment. We leverage automation and AI to curate, maintain, and deliver 1,400+ high-quality browser games to players worldwide. No downloads, no installations, just pure gaming joy.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="By the Numbers"
    stats={[
      { title: 'Games Available', amount: '1,400+' },
      { title: 'Game Categories', amount: '20+' },
      { title: 'Languages', amount: '3' },
      { title: 'Founded', amount: '2025' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Mission & Values"
    subtitle="What drives us every day"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'AI-Powered Curation',
        description:
          'We use AI and automation to continuously discover, categorize, and maintain our game collection. This allows us to offer a growing library while keeping operational costs minimal.',
        icon: 'tabler:robot',
      },
      {
        title: 'Always Free',
        description:
          'We believe great gaming should be accessible to everyone, everywhere. All games on MiniGamesHub are 100% free, forever. No paywalls, no subscriptions.',
        icon: 'tabler:gift',
      },
      {
        title: 'Privacy Matters',
        description:
          'Your data is yours. We never sell your information, never track you unnecessarily, and are fully transparent about our practices in our privacy policy.',
        icon: 'tabler:shield-lock',
      },
    ]}
  />

  <!-- How We Operate Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-slate-50 dark:bg-slate-900/30 rounded-lg mt-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-2 font-heading">How We Operate</h2>
    <p class="text-center text-muted mb-12">An AI-native approach to game curation and platform management</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4">🤖</div>
        <h3 class="text-xl font-bold mb-2">Automated Discovery</h3>
        <p class="text-sm">Our systems continuously scan and discover new HTML5 games from trusted sources, using AI to evaluate quality and categorize games automatically.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4">⚡</div>
        <h3 class="text-xl font-bold mb-2">Instant Updates</h3>
        <p class="text-sm">When new games are added to our sources, they appear on MiniGamesHub within hours — no manual curation delays. Our n8n automation pipeline handles everything.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4">🌍</div>
        <h3 class="text-xl font-bold mb-2">Multi-Language</h3>
        <p class="text-sm">We serve players worldwide with content in English, Spanish, and Chinese. AI-assisted localization ensures quality across all languages.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4">🔧</div>
        <h3 class="text-xl font-bold mb-2">Built With Modern Tech</h3>
        <p class="text-sm">Our platform runs on Astro (static site generation), Tailwind CSS, and TypeScript — delivering lightning-fast page loads and excellent Core Web Vitals.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4">🔄</div>
        <h3 class="text-xl font-bold mb-2">Continuous Improvement</h3>
        <p class="text-sm">We use AI-assisted development tools (Cursor, Claude Code, Code Buddy) to continuously improve the platform — from SEO optimization to user experience.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm">
        <div class="text-5xl mb-4">🎯</div>
        <h3 class="text-xl font-bold mb-2">Player-First Design</h3>
        <p class="text-sm">No pop-ups, no deceptive ads, no forced sign-ups. We design for players who just want to click and play. Your time and experience come first.</p>
      </div>
    </div>
  </section>

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Content Standards"
    subtitle="How we maintain a quality game collection"
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Automated Screening',
        description:
          'Our AI pipeline screens games for basic quality signals — proper loading, responsive design, and appropriate content — before they appear on the site.',
        icon: 'tabler:filter',
      },
      {
        title: 'Regular Updates',
        description:
          'Our automation continuously syncs with game sources to add new games and remove broken ones. The collection stays fresh without manual effort.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Player Feedback',
        description:
          'We monitor game popularity and user engagement to surface the best games. Underperforming or broken games are automatically flagged for review.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="How Our Platform Works"
    subtitle="From discovery to your screen — powered by automation"
    items={[
      {
        title: 'Step 1: Game Discovery',
        description: 'Our systems continuously scan trusted game sources via APIs and RSS feeds to discover new HTML5 games from developers worldwide.',
        icon: 'tabler:search',
      },
      {
        title: 'Step 2: Automated Processing',
        description: 'AI evaluates each game\'s metadata, screenshots, and technical specs. Games are automatically categorized, tagged, and prepared for listing.',
        icon: 'tabler:robot',
      },
      {
        title: 'Step 3: Multi-Language Publishing',
        description: 'Game descriptions and metadata are localized into English, Spanish, and Chinese. The site is rebuilt automatically via CI/CD when new games are added.',
        icon: 'tabler:language',
      },
      {
        title: 'Step 4: Continuous Optimization',
        description: 'We monitor game performance, user engagement, and SEO metrics. AI-assisted tools help us continuously improve the platform and player experience.',
        icon: 'tabler:trending-up',
      },
    ]}
  />

  <!-- Our Story Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-8 font-heading">Our Story</h2>
    
    <div class="prose dark:prose-invert max-w-none">
      <p>
        <strong>MiniGamesHub was created by Synthflow Digital LTD</strong>, an AI-native company on a mission to build autonomous digital businesses. 
        Rather than hiring a large team of game curators, we built automated systems that discover, organize, and deliver browser games at scale.
      </p>

      <p>
        The idea was simple: <strong>use AI and automation to do what would traditionally require a team of 20+ people</strong> — game discovery, categorization, 
        content writing, SEO optimization, and platform maintenance. This approach lets us offer a growing collection of games while keeping the platform free for everyone.
      </p>

      <p>
        <strong>We believe in radical transparency.</strong> Unlike many game sites that inflate their numbers or fabricate team pages, we're upfront about 
        how we operate. MiniGamesHub is an AI-powered platform, and we're proud of the efficiency and scale that enables.
      </p>

      <p>
        Our goal is simple: <strong>build the best free browser games platform on the internet</strong>, powered by automation, loved by players.
      </p>

      <hr class="my-8" />

      <h3 class="text-xl font-bold">Our Company Information</h3>

      <ul>
        <li><strong>Legal Name:</strong> Synthflow Digital LTD</li>
        <li><strong>Registration:</strong> United Kingdom</li>
        <li><strong>Address:</strong> Office 16430, 182-184 High Street North, East Ham, London, E6 2JA</li>
        <li><strong>Contact Email:</strong> contact@minigameshub.org</li>
        <li><strong>Press Inquiries:</strong> press@minigameshub.org</li>
      </ul>
    </div>
  </section>

  <!-- Trust & Safety Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-blue-50 dark:bg-blue-950/20 rounded-lg mb-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-2 font-heading">Trust, Safety & Transparency</h2>
    <p class="text-center text-muted mb-12">Why millions of players trust us with their time</p>

    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-xl font-bold mb-4">🛡️ Safety First</h3>
        <ul class="list-disc pl-6 space-y-2 text-muted">
          <li>All games scanned for malware and safety issues</li>
          <li>No deceptive "download" buttons or pop-ups</li>
          <li>All links go to the places they say they do</li>
          <li>Age-appropriate content only</li>
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-bold mb-4">🔒 Privacy Focused</h3>
        <ul class="list-disc pl-6 space-y-2 text-muted">
          <li>Read our <a href="/privacy" class="text-accent hover:underline">full privacy policy</a></li>
          <li>We never sell your data</li>
          <li>Minimal tracking for site improvement only</li>
          <li>GDPR, CCPA, and COPPA compliant</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Technology Stack -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-2 font-heading">Technology Stack</h2>
    <p class="text-center text-muted mb-12">The tools and platforms that power MiniGamesHub</p>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
        <div class="text-lg font-bold mb-2">Frontend</div>
        <p class="text-muted">Astro 5 (SSG), Tailwind CSS 3.4, TypeScript 5.8. Static site generation for blazing-fast page loads and excellent SEO.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
        <div class="text-lg font-bold mb-2">Automation</div>
        <p class="text-muted">n8n workflow automation, AI-assisted content generation, CI/CD pipelines for continuous deployment.</p>
      </div>

      <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
        <div class="text-lg font-bold mb-2">AI & Development</div>
        <p class="text-muted">Cursor, Claude Code, Code Buddy for AI-assisted development. DeepSeek API for content generation and localization.</p>
      </div>
    </div>
  </section>

  <!-- Get in Touch Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/30 dark:to-purple-900/30 rounded-lg mb-8">
    <h2 class="text-3xl md:text-4xl font-bold mb-4 font-heading">Get in Touch</h2>
    <p class="text-xl mb-8 text-muted">We love hearing from our community!</p>
    
    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <div class="text-4xl mb-3">📧</div>
        <h3 class="font-bold">General Inquiries</h3>
        <p class="text-muted">contact@minigameshub.org</p>
      </div>
      <div>
        <div class="text-4xl mb-3">💡</div>
        <h3 class="font-bold">Game Suggestions</h3>
        <p class="text-muted">suggestions@minigameshub.org</p>
      </div>
      <div>
        <div class="text-4xl mb-3">📰</div>
        <h3 class="font-bold">Press</h3>
        <p class="text-muted">press@minigameshub.org</p>
      </div>
    </div>

    <a href="/contact" class="inline-block mt-8 px-8 py-3 bg-accent text-white font-bold rounded-lg hover:opacity-90 transition">
      Contact Us Now
    </a>
  </section>

  <!-- Editorial Guidelines CTA -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
    <p class="text-muted">
      Curious how we keep our game library safe and high-quality?
      <a href="/editorial-guidelines" class="text-accent font-semibold hover:underline">Read our Editorial Guidelines &amp; Review Process</a>.
    </p>
  </section>

  <!-- Footer Note -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center">
    <p class="text-muted">
      Thank you for being part of the MiniGamesHub community. We're constantly improving the platform with better games and smarter automation.
    </p>
    <p class="text-muted mt-2 font-bold">
      — Synthflow Digital LTD
    </p>
  </section>
</Layout>
