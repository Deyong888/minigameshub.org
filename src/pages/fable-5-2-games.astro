---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Claude Fable 5.2 Games – Play Free AI-Made 3D Games Online',
  description:
    'Play the best free games built with Claude Fable 5.2 — Saltline, Turbo Tails, Evensong, Bayhaven and more. AI-made 3D browser games, no downloads, instant play.',
  // No locale versions of this page exist; skip hreflang so we don't point at 404s.
  skipHreflang: true,
};

// Playable in an iframe on this page. URLs copied verbatim from the research
// report (2026-11-15); Bayhaven direct link read from the fable52 play
// page's embedded playUrl field and verified framable live.
const iframeGames = [
  {
    name: 'Oil Paint',
    author: 'Blendi Byl',
    handle: '@BlendiByl',
    genre: 'Walking Exploration',
    url: 'https://patch.gg/blendi/oil-paint',
    description:
      'As a lantern-carrying wanderer, take slow walks through a snow ridge under the aurora to a cabin, and an autumn wood. No objectives — atmosphere is the game. Code MIT, art CC0.',
  },
  {
    name: 'What the Water Keeps',
    author: 'Kevin Ngo',
    handle: '@kevin_t_ngo',
    genre: 'Meditative Boat Ride',
    url: 'https://what-the-water-keeps.vercel.app/',
    description:
      'Drift by lantern light through dreamlike realms in one night; steer and paddle, or let the current carry you. Nothing to win or lose.',
  },
  {
    name: 'Evensong',
    author: 'Kevin Ngo',
    handle: '@kevin_t_ngo',
    genre: 'Dark-Fantasy Boss Fight',
    url: 'https://evensong-phi.vercel.app/',
    description:
      'Fight a boss in a drowned cathedral with lock-on, dodge rolls, a healing flask and blocking. A souls-like duel in a single arena.',
  },
  {
    name: 'CROSSTOWN',
    author: 'Matt Shumer',
    handle: '@mattshumer_',
    genre: 'Open-World City',
    url: 'https://nyc.somethingbig.ai/',
    description:
      'Explore an open-world New York in this early preview — only part of the city is in so far, and the build is still growing.',
  },
  {
    name: 'Portals: Endless Worlds',
    author: 'Ethan Mollick',
    handle: '@emollick',
    genre: 'Portal-Hopping Explorer',
    url: 'https://portals-endless-worlds.netlify.app/',
    description:
      'Drift through portals linking a sprawling network of code-only 3D worlds inspired by books, art and places.',
  },
  {
    name: 'LANTERNFALL',
    author: 'loktar00',
    handle: '@loktar00',
    genre: '3D Auto-Battler',
    url: 'https://loktar00.github.io/lanternfall/',
    description:
      'Build your team and watch it fight in a 3D auto-battler — animations and models all generated by Fable.',
  },
  {
    name: 'Mist-Locked Mountain Gate',
    author: 'op7418',
    handle: '@op7418',
    genre: 'Xianxia Action',
    url: 'https://op7418.github.io/guizang-game-skill/',
    description:
      'Climb a misty mountain gate, fight guards and duel a general in a top-down xianxia action game.',
  },
  {
    name: 'Tennis',
    author: 'photonstorm',
    handle: '@photonstorm',
    genre: 'Arcade Tennis',
    url: 'https://tennis.sixfingerpunch.com/',
    description:
      "Asked to 'go wild,' Fable returned what looks like a Pong clone — until you play it.",
  },
  {
    name: 'Gilt & Gutter',
    author: 'Kevin Ngo',
    handle: '@kevin_t_ngo',
    genre: 'FPS Demo',
    url: 'https://gilt-and-gutter.vercel.app/',
    description:
      'A head-to-head FPS demo — pick a character and duel in a moody arena.',
  },
  {
    name: 'Turbo Tails',
    author: 'Peter Yang',
    handle: '@petergyang',
    genre: '3D Kart Racer',
    url: 'https://turbo-tails.vercel.app/',
    description:
      'Race karters with drifting, ramps and items, single-player or multiplayer; coins speed you up, drifts and tricks fill the turbo meter.',
  },
  {
    name: 'I Would Have Gotten Away With It',
    author: 'Ethan Mollick',
    handle: '@emollick',
    genre: 'Reverse Horror-Comedy Stealth',
    url: 'https://i-would-have-gotten-away-with-it.netlify.app/',
    description:
      'Reverse Scooby-Doo — you are the villain scaring off meddling kids in a manor.',
  },
  {
    name: "Aiden's Revenge",
    author: 'Lex Toumbourou',
    handle: '',
    genre: "Beat 'Em Up",
    url: 'https://aidens-revenge.pages.dev/',
    description:
      "A beat 'em up built from the creator's nephew's hand-drawn designs, with controller support.",
  },
  {
    name: 'Bayhaven',
    author: 'fablestar',
    handle: '',
    genre: 'Open-World Crime Comedy',
    url: 'https://fablestar.games/play/',
    description:
      'Play Mags, a retired getaway driver, and Teo in a sunny neon coastal city; steal cars, outrun a sheriff, with police heat measured in livestream viewers.',
  },
];

// The creators' sites block embedding (framing headers), so these open on the
// original site in a new tab instead of loading in an iframe here.
const externalGames = [
  {
    name: 'Saltline',
    author: 'Felix Rieseberg',
    handle: '@felixrieseberg',
    genre: 'First-Person Shooter',
    url: 'https://claude.ai/artifact/BGY1SztrAYcJQHSsnHHGmp',
    description:
      'Cut uplink relays in a rainy container port, fighting Gull drones and Hound robot dogs, then escape by boat. The launch-week flagship — a full FPS built in a single session.',
    note: "Claude artifacts block embedding, so the official version opens on claude.ai in a new tab.",
  },
  {
    name: 'Starry Nightrider',
    author: 'Ebby Amir',
    handle: '@ebbyamir',
    genre: 'Artistic 3D Exploration',
    url: 'https://starrynightrider.com/',
    description:
      "Ride a bicycle through Van Gogh's Starry Night, collect orbs and carry them into the steeple; do tricks and fly.",
    note: "The creator's site blocks embedding, so this game opens on the original site in a new tab.",
  },
  {
    name: 'Mirror Earth',
    author: 'Matt Shumer',
    handle: '@mattshumer_',
    genre: 'Voxel Planet Sandbox',
    url: 'https://www.spawn.co/@mattshumer/earth?room=local',
    description:
      'Play with the whole planet as a destructible voxel game world; in-game weather matches real Earth in real time.',
    note: "The creator's site blocks embedding, so this game opens on the original site in a new tab.",
  },
];

const faqs = [
  {
    question: 'What is Claude Fable 5.2?',
    answer:
      'Claude Fable 5.2 is a model from Anthropic, released on November 9, 2026, built for creating interactive experiences. Within days of its release, creators were publishing full 3D browser games made with it — shooters, racers, open-world sandboxes, and atmospheric explorations — most of them built by individuals in a matter of hours.',
  },
  {
    question: 'Are these Fable 5.2 games free to play?',
    answer:
      'Yes. Every game on this page is free to play in your browser. Each one is hosted by its own creator, so there is nothing to buy, download, or sign up for on this site.',
  },
  {
    question: 'Do I need to download anything to play?',
    answer:
      'No downloads, no installs, no plugins. Click the Play button on any game card and it loads right in the page. A few of these are heavy 3D scenes, so give them a moment to load — especially on slower connections.',
  },
  {
    question: 'Why do some games open on another site instead of playing here?',
    answer:
      "Some creators' sites send headers that block embedding, so their games can't load inside this page. For those, the Play button opens the game on the creator's own site in a new tab. The game is the same — it just plays on its original home.",
  },
];

const allGames = [...iframeGames, ...externalGames];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Claude Fable 5.2 Games',
      description: metadata.description,
      url: 'https://minigameshub.org/fable-5-2-games',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: allGames.map((game, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'VideoGame',
            name: game.name,
            url: game.url,
            description: game.description,
            genre: game.genre,
            playMode: 'SinglePlayer',
            applicationCategory: 'Game',
            author: {
              '@type': 'Person',
              name: game.author,
            },
          },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a
            href="/"
            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white"
          >
            <svg class="w-3 h-3 mr-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z" />
            </svg>
            Home
          </a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
            </svg>
            <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2 dark:text-gray-400">Fable 5.2 Games</span>
          </div>
        </li>
      </ol>
    </nav>

    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter mb-4 text-center">
      Claude Fable 5.2 Games
    </h1>
    <p class="text-xl text-muted mb-8 text-center">
      Free AI-made 3D games, playable in your browser — no downloads, no sign-up.
    </p>

    <div class="prose prose-lg dark:prose-invert max-w-none mb-12 text-gray-700 dark:text-gray-300">
      <p>
        On November 9, 2026, Anthropic released Claude Fable 5.2, a model built for creating interactive
        experiences — and within days, the browser-games corner of the internet looked completely different.
        Individual creators and small teams started shipping full 3D games made almost entirely by AI: shooters
        with real combat, open-world cities, kart racers, souls-like boss fights, and slow atmospheric walks
        through painted landscapes. These were not tech demos or video clips. They were playable, in the browser,
        for free, the same week the model came out. This page collects the best of that launch-week wave — the
        games that are genuinely fun to play right now, not just impressive to watch. Every title below was
        checked for a working playable link on November 15, 2026, and each card tells you who made it and where
        it is hosted.
      </p>
      <p>
        The game that started the wave is Saltline, a first-person shooter by Felix Rieseberg, an engineer at
        Anthropic. Set in a rainy container port, it has you cutting uplink relays while Gull drones and Hound
        robot dogs hunt you down, then escaping by boat. Rieseberg built it in about 8 hours for roughly $550 in
        API costs, by his own account — every model, sound, and texture generated in code. It became the flagship
        of the launch week and the clearest proof of what the new model could do: one person, one session, a game
        that looks and plays like something from a small studio. You can play it on this page through a fan
        mirror, with a link to the official version on Claude.
      </p>
      <p>
        What followed was stranger and wider than a single shooter. Kevin Ngo shipped two games in the same week
        that could not be more different: a lantern-lit boat ride through dreamlike realms, and a dark-fantasy
        boss fight in a drowned cathedral. Matt Shumer put a whole voxel planet in the browser and started
        building an open-world New York. A kart racer, a xianxia mountain climb, a reverse horror-comedy where
        you play the villain scaring off meddling kids, a beat &apos;em up built from a child&apos;s hand-drawn
        designs — the range is the point. Some of these games are polished and complete; others are early
        previews still growing in public. All of them run in the browser with no download, and all of them were
        made with Fable 5.2.
      </p>
      <p>
        A note on what this page is: a curated collection, not a store. Every game here is hosted by its own
        creator — on their own site, on GitHub Pages, Vercel, or Netlify, or on a platform like Patch and Spawn.
        We do not own these games, we have not changed them, and we are not claiming credit for them. Click Play
        on any card and the game loads in place, streamed from the creator&apos;s own hosting. A few
        creators&apos; sites block embedding, so those games open on the original site in a new tab instead. If a
        game moves, changes, or comes down, that is the creator&apos;s decision, and we will update this page as
        we learn about it.
      </p>
      <p>
        To play, click the Play button on any game — it loads only when you ask it to, because several of these
        are heavy 3D scenes. Most play with keyboard and mouse; check each game&apos;s own start screen for
        controls. Some will ask to lock your pointer for first-person controls — that is normal for browser
        shooters, and pressing Escape always hands control back to you. If you enjoy a game, the best thing you
        can do is share the creator&apos;s own link and tell them so. And if this page leaves you wanting more instant-play games, our
        <a href="/category/action" class="text-primary hover:underline">action</a>,
        <a href="/category/racing" class="text-primary hover:underline">racing</a>, and
        <a href="/category/adventure" class="text-primary hover:underline">adventure</a> categories hold thousands
        of free browser titles that run the same way: open the page, click, play.
      </p>
    </div>

    <!-- Section quick links -->
    <div class="flex flex-wrap justify-center gap-2 mb-4">
      <a href="#play-in-browser" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Play in Your Browser</a>
      <a href="#play-on-original-site" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Play on the Original Site</a>
      <a href="/category/action" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Action Games</a>
      <a href="/category/racing" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Racing Games</a>
    </div>

    <h2 id="play-in-browser" class="text-3xl font-bold text-center mt-12 mb-2 scroll-mt-24">
      Play in Your Browser
    </h2>
    <p class="text-center text-muted mb-8">
      Click Play on any game to load it here. Games only load when you ask — several are heavy 3D scenes.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-16">
      {iframeGames.map((game) => (
        <article class="bg-white dark:bg-slate-800 rounded-lg overflow-hidden shadow hover:shadow-lg transition border border-gray-200 dark:border-slate-700">
          <div
            class="relative aspect-video bg-slate-900"
            data-fable-player
            data-url={game.url}
            data-title={game.name}
          >
            <div
              class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-4 text-center"
              data-fable-cover
            >
              <p class="text-white font-bold text-lg">{game.name}</p>
              <p class="text-slate-300 text-sm">{game.genre}</p>
              <button
                type="button"
                data-fable-play
                class="px-6 py-2 bg-primary text-white rounded-full font-semibold hover:opacity-90 transition"
              >
                Play
              </button>
              <p class="text-slate-400 text-xs">Loads from the creator&apos;s site when you press Play</p>
            </div>
            <button
              type="button"
              data-fable-fullscreen
              class="hidden absolute top-2 right-2 z-10 px-2 py-1 bg-black/60 text-white text-xs rounded hover:bg-black/80 transition"
            >
              Fullscreen
            </button>
          </div>
          <div class="p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-bold text-lg">{game.name}</h3>
              <span class="shrink-0 text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 rounded-full">
                {game.genre}
              </span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
              by {game.author}
              {game.handle && ` (${game.handle})`}
            </p>
            <p class="text-sm text-gray-700 dark:text-gray-300 mt-3">{game.description}</p>
            {game.note && (
              <p class="text-xs text-amber-600 dark:text-amber-400 mt-3">{game.note}</p>
            )}
          </div>
        </article>
      ))}
    </div>

    <h2 id="play-on-original-site" class="text-3xl font-bold text-center mt-12 mb-2 scroll-mt-24">
      Play on the Original Site
    </h2>
    <p class="text-center text-muted mb-8">
      These creators&apos; sites block embedding, so their games open on the original site in a new tab.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-16">
      {externalGames.map((game) => (
        <article class="bg-white dark:bg-slate-800 rounded-lg overflow-hidden shadow hover:shadow-lg transition border border-gray-200 dark:border-slate-700">
          <div class="p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-bold text-lg">{game.name}</h3>
              <span class="shrink-0 text-xs px-2 py-1 bg-gray-100 dark:bg-slate-700 rounded-full">
                {game.genre}
              </span>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
              by {game.author}
              {game.handle && ` (${game.handle})`}
            </p>
            <p class="text-sm text-gray-700 dark:text-gray-300 mt-3">{game.description}</p>
            <p class="text-xs text-amber-600 dark:text-amber-400 mt-3">{game.note}</p>
            <a
              href={game.url}
              target="_blank"
              rel="noopener"
              class="inline-block mt-4 px-6 py-2 bg-primary text-white rounded-full font-semibold hover:opacity-90 transition"
            >
              Play on the original site
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700 max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-8">Fable 5.2 Games — FAQ</h2>
      <div class="space-y-6 text-gray-700 dark:text-gray-300">
        {faqs.map((faq) => (
          <div>
            <p class="font-bold text-gray-900 dark:text-white mb-1">{faq.question}</p>
            <p>{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-2xl font-bold text-center mb-8">Keep Playing</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/category/action" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Action Games</h3>
          <p class="text-sm text-gray-500">Shooters, fighters, and fast-paced arcade action — free in your browser.</p>
        </a>
        <a href="/category/racing" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Racing Games</h3>
          <p class="text-sm text-gray-500">Kart racers, drift challenges, and high-speed chases.</p>
        </a>
        <a href="/category/adventure" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Adventure Games</h3>
          <p class="text-sm text-gray-500">Open worlds, quests, and exploration — more worlds to get lost in.</p>
        </a>
      </div>
    </div>

    <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-16">
      Updated November 15, 2026. All games are hosted by their respective creators.
    </p>
  </section>

  <script is:inline>
    // Click-to-load players: a game iframe is only created when its Play button
    // is pressed, so heavy 3D scenes never all load at once.
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('[data-fable-player]').forEach(function (box) {
        var playBtn = box.querySelector('[data-fable-play]');
        var fsBtn = box.querySelector('[data-fable-fullscreen]');
        playBtn.addEventListener('click', function () {
          var iframe = document.createElement('iframe');
          iframe.src = box.getAttribute('data-url');
          iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-pointer-lock');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('allow', 'fullscreen');
          iframe.className = 'absolute inset-0 w-full h-full border-0';
          iframe.title = box.getAttribute('data-title') + ' — play online';
          box.querySelector('[data-fable-cover]').remove();
          box.appendChild(iframe);
          if (fsBtn) fsBtn.classList.remove('hidden');
        });
        if (fsBtn) {
          fsBtn.addEventListener('click', function () {
            if (box.requestFullscreen) box.requestFullscreen();
          });
        }
      });
    });
  </script>
</Layout>
