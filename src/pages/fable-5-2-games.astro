---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { fableGames, fableSection, moreSection } from '~/data/fable-games';
import GameCard from '~/components/fable/GameCard.astro';

const metadata = {
  title: 'Claude Fable 5.2 Games – Play Free AI-Made 3D Games Online',
  description:
    'Play 25 free AI-built browser games — Saltline, Turbo Tails, Evensong, World of ClaudeCraft, Battle Drones and more. Fable 5.2 games plus other AI-made hits, no downloads, instant play.',
  // No locale versions of this page exist; skip hreflang so we don't point at 404s.
  skipHreflang: true,
};

const faqs = [
  {
    question: 'What is Claude Fable 5.2?',
    answer:
      'Claude Fable 5.2 is a model from Anthropic, released on November 9, 2026, built for creating interactive experiences. Within days of its release, creators were publishing full 3D browser games made with it — shooters, racers, open-world sandboxes, and atmospheric explorations — most of them built by individuals in a matter of hours. The “More AI-Built Games” section below collects standout games built with other AI tools, and every card names the tool that actually built it.',
  },
  {
    question: 'Are these AI-built games free to play?',
    answer:
      'Yes. Every game on this page is free to play in your browser. Each one is hosted by its own creator, so there is nothing to buy, download, or sign up for on this site.',
  },
  {
    question: 'Do I need to download anything to play?',
    answer:
      'No downloads, no installs, no plugins. Click a game card to open its page, then press Play — the game loads right in the page. A few of these are heavy 3D scenes, so give them a moment to load, especially on slower connections.',
  },
  {
    question: 'Why do some games open on another site instead of playing here?',
    answer:
      "Some creators' sites send headers that block embedding, so their games can't load inside this page. For those, the game's page has a big button that opens it on the creator's own site in a new tab. The game is the same — it just plays on its original home.",
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Claude Fable 5.2 Games',
      description: metadata.description,
      url: 'https://minigameshub.org/fable-5-2-games',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: fableGames.map((game, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: `https://minigameshub.org/fable-5-2-games/${game.slug}`,
          item: {
            '@type': 'VideoGame',
            name: game.name,
            url: `https://minigameshub.org/fable-5-2-games/${game.slug}`,
            description: game.description,
            genre: game.genre,
            playMode: 'SinglePlayer',
            applicationCategory: 'Game',
            ...(game.author ? { author: { '@type': 'Person', name: game.author } } : {}),
          },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a
            href="/"
            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary dark:text-gray-400 dark:hover:text-white"
          >
            <Icon name="tabler:home" class="w-4 h-4 mr-1.5" aria-hidden="true" />
            Home
          </a>
        </li>
        <li aria-current="page" class="flex items-center">
          <Icon name="tabler:chevron-right" class="w-3.5 h-3.5 text-gray-400 mx-1" aria-hidden="true" />
          <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Fable 5.2 Games</span>
        </li>
      </ol>
    </nav>

    {/* Hero */}
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-violet-600 via-indigo-600 to-blue-700 px-6 py-12 sm:px-10 sm:py-16 text-white text-center">
      <Icon
        name="tabler:device-gamepad-2"
        class="absolute -left-8 -bottom-10 w-56 h-56 text-white/10"
        aria-hidden="true"
      />
      <Icon name="tabler:sparkles" class="absolute -right-6 -top-6 w-44 h-44 text-white/10" aria-hidden="true" />
      <div class="relative">
        <p class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide uppercase px-3 py-1.5 bg-white/20 rounded-full backdrop-blur-sm">
          <Icon name="tabler:sparkles" class="w-3.5 h-3.5" aria-hidden="true" />
          AI-built · Free · No downloads
        </p>
        <h1 class="font-bold font-heading text-4xl sm:text-5xl md:text-6xl leading-tighter tracking-tighter mt-5">
          Claude Fable 5.2 Games
        </h1>
        <p class="text-lg sm:text-xl text-white/90 mt-4 max-w-2xl mx-auto">
          Free AI-made 3D games, playable in your browser — click any card to open its page and play.
        </p>
        <div class="flex flex-wrap justify-center gap-2 mt-6">
          <span class="text-sm font-semibold px-3 py-1.5 bg-white/20 rounded-full backdrop-blur-sm">
            {fableGames.length} games
          </span>
          <span class="text-sm font-semibold px-3 py-1.5 bg-white/20 rounded-full backdrop-blur-sm">
            {fableSection.length} built with Fable 5.2
          </span>
          <span class="text-sm font-semibold px-3 py-1.5 bg-white/20 rounded-full backdrop-blur-sm">
            {moreSection.length} more AI-built hits
          </span>
        </div>
      </div>
    </div>

    {/* Intro */}
    <div class="prose prose-lg dark:prose-invert max-w-4xl mx-auto mt-12 mb-4 text-gray-700 dark:text-gray-300">
      <p>
        On November 9, 2026, Anthropic released Claude Fable 5.2, a model built for creating interactive
        experiences — and within days, the browser-games corner of the internet looked completely different.
        Individual creators started shipping full 3D games made almost entirely by AI: shooters with real combat,
        open-world cities, kart racers, souls-like boss fights, and slow atmospheric walks through painted
        landscapes. These were not tech demos or video clips. They were playable, in the browser, for free, the
        same week the model came out. This page collects the best of that launch-week wave — the games that are
        genuinely fun to play right now, not just impressive to watch. Every game has its own page: open it, press
        Play, and the game loads in place.
      </p>
      <p>
        The game that started the wave is Saltline, a first-person shooter by Felix Rieseberg, an engineer at
        Anthropic. Set in a rainy container port, it has you cutting uplink relays while Gull drones and Hound
        robot dogs hunt you down, then escaping by boat. Rieseberg built it in about 8 hours for roughly $550 in
        API costs, by his own account — every model, sound, and texture generated in code. Below it you will find
        a lantern-lit boat ride, a souls-like boss fight, a voxel planet, a kart racer, and a beat &apos;em up
        built from a child&apos;s hand-drawn designs. The range is the point.
      </p>
      <p>
        The second section, “More AI-Built Games,” goes beyond the launch week: standout browser games built with
        other AI tools — a full browser MMORPG, a real-time strategy game, a 1990s-style MUD, and more. Each card
        names the tool that actually built the game, so nothing here is mislabeled. A note on what this page is: a
        curated collection, not a store. Every game is hosted by its own creator, and we do not own these games
        or claim credit for them. If a game moves, changes, or comes down, that is the creator&apos;s decision,
        and we will update this page as we learn about it. If this page leaves you wanting more instant-play
        games, our
        <a href="/category/action" class="text-primary hover:underline">action</a>,
        <a href="/category/racing" class="text-primary hover:underline">racing</a>, and
        <a href="/category/adventure" class="text-primary hover:underline">adventure</a> categories hold thousands
        of free browser titles that run the same way: open the page, click, play.
      </p>
    </div>

    {/* Section quick links */}
    <div class="flex flex-wrap justify-center gap-2 mt-8 mb-4">
      <a href="#fable-52" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Fable 5.2 Games</a>
      <a href="#more-ai-built" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">More AI-Built Games</a>
      <a href="/category/action" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Action Games</a>
      <a href="/category/racing" class="px-3 py-1 bg-gray-100 dark:bg-slate-700 rounded-full text-sm hover:bg-primary hover:text-white transition">Racing Games</a>
    </div>

    <h2 id="fable-52" class="text-3xl font-bold text-center mt-12 mb-2 scroll-mt-24">
      Fable 5.2 Games
    </h2>
    <p class="text-center text-muted mb-8">
      {fableSection.length} games built with Claude Fable 5.2 in launch week — click a card to play.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {fableSection.map((game) => (
        <GameCard game={game} />
      ))}
    </div>

    <h2 id="more-ai-built" class="text-3xl font-bold text-center mt-12 mb-2 scroll-mt-24">
      More AI-Built Games
    </h2>
    <p class="text-center text-muted mb-8 max-w-2xl mx-auto">
      Standout browser games built with other AI tools — Fable 5, Opus 5.5, Claude Code, Cursor, and Codex. Each
      card names the tool that actually built the game.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {moreSection.map((game) => (
        <GameCard game={game} />
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700 max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-8">Fable 5.2 Games — FAQ</h2>
      <div class="space-y-6 text-gray-700 dark:text-gray-300">
        {faqs.map((faq) => (
          <div>
            <p class="font-bold text-gray-900 dark:text-white mb-1">{faq.question}</p>
            <p>{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-2xl font-bold text-center mb-8">Keep Playing</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/category/action" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Action Games</h3>
          <p class="text-sm text-gray-500">Shooters, fighters, and fast-paced arcade action — free in your browser.</p>
        </a>
        <a href="/category/racing" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Racing Games</h3>
          <p class="text-sm text-gray-500">Kart racers, drift challenges, and high-speed chases.</p>
        </a>
        <a href="/category/adventure" class="p-6 bg-gray-50 dark:bg-slate-800 rounded-lg hover:shadow-lg transition text-center group">
          <h3 class="font-bold text-lg mb-2 group-hover:text-primary">Adventure Games</h3>
          <p class="text-sm text-gray-500">Open worlds, quests, and exploration — more worlds to get lost in.</p>
        </a>
      </div>
    </div>

    <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-16">
      Updated November 15, 2026. All games are hosted by their respective creators.
    </p>
  </section>
</Layout>
